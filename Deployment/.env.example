# ============================================================================
# Deployment/.env.example
# ----------------------------------------------------------------------------
# Copy to .env on each VM (the startup script's edu-fetch-secrets.sh renders
# this automatically from Secret Manager). All compose files read this file:
#   docker compose -f docker-compose.app.yml --env-file .env up -d
#
# .env is git-ignored - NEVER commit real secrets.
# ============================================================================

# --- Cross-VM addressing (must match the Terraform static internal IPs) -----
APP_SERVER_IP=10.0.0.11
AI_SERVER_IP=10.0.0.12

# --- Odoo -------------------------------------------------------------------
ODOO_DB=edu_demo_new
ODOO_USERNAME=admin
ODOO_PASSWORD=change-me-strong
ODOO_MASTER_PASSWORD=change-me-strong

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_PASSWORD=change-me-strong

# --- JWT --------------------------------------------------------------------
JWT_SECRET_KEY=change-me-min-32-chars-aaaaaaaaaaaaaaaa

# --- Chatbot / LLM ----------------------------------------------------------
CHATBOT_SHARED_SECRET=change-me
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- OCR --------------------------------------------------------------------
MISTRAL_API_KEY=

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=change-me-strong

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=change-me-strong

# --- CORS -------------------------------------------------------------------
# Set to your public origin in production, e.g. https://erp.example.com
CORS_ORIGINS=*

# --- Monitoring (optional) --------------------------------------------------
GRAFANA_PASSWORD=change-me-strong
