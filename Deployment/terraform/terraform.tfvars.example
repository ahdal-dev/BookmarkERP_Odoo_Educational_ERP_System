# ============================================================================
# terraform.tfvars.example
# ----------------------------------------------------------------------------
# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
#   cp terraform.tfvars.example terraform.tfvars
#
# For a one-shot full deploy you can instead pass an environment file:
#   terraform apply -var-file=environments/trial-credits.tfvars
# ============================================================================

# --- Core ---------------------------------------------------------------
project_id  = "my-gcp-project-id"
region      = "us-central1"
zone        = "us-central1-a"
environment = "trial-credits"
name_prefix = "edu-erp"

# --- Networking ---------------------------------------------------------
# Lock SSH to your own IP. Find it with:  curl -s ifconfig.me
ssh_source_ranges = ["203.0.113.4/32"] # CHANGE ME

# --- Machine sizing (full trial-credits deployment) ---------------------
proxy_machine_type = "e2-micro"      # Always-Free
app_machine_type   = "e2-standard-2" # ~$49/mo
ai_machine_type    = "e2-medium"     # ~$25/mo

deploy_app_vm = true
deploy_ai_vm  = true

# --- Optional auto-deploy from git --------------------------------------
# repo_url    = "https://github.com/Noureqo1/Odoo_Educational_ERP_System.git"
# repo_branch = "main"
# auto_deploy = false   # leave false; deploy manually for first run (Phases 5-9)

# --- DNS (optional) -----------------------------------------------------
enable_dns = false
# dns_domain    = "erp.example.com."   # trailing dot
# dns_zone_name = "edu-erp-zone"

# --- Secrets ------------------------------------------------------------
# RECOMMENDED: leave these empty and add versions via gcloud after apply:
#   echo -n "the-value" | gcloud secrets versions add edu-erp-jwt-secret-key --data-file=-
# Or set them here (stored in state - use only for throwaway/trial projects):
secret_values = {
  odoo-password         = ""
  postgres-password     = ""
  jwt-secret-key        = ""
  chatbot-shared-secret = ""
  openrouter-api-key    = ""
  mistral-api-key       = ""
  rabbitmq-user         = ""
  rabbitmq-password     = ""
  redis-password        = ""
  grafana-password      = ""
}
