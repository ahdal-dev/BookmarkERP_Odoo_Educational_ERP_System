# ============================================================================
# Deployment/.gitignore - keep secrets and state out of git
# ============================================================================

# Rendered runtime env (contains secret values)
.env

# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log
terraform/terraform.tfvars
terraform/*.auto.tfvars
terraform/override.tf
terraform/override.tf.json

# Frontend build artifacts copied to the proxy
frontend-dist/

# TLS material
nginx/ssl/*.pem
nginx/ssl/*.crt
nginx/ssl/*.key

# OCR scratch
temp/
