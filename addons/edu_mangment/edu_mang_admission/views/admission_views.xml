<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_admission_success" model="mail.template">
        <field name="name">Admission Received</field>
        <field name="model_id" ref="edu_mang_admission.model_school_admission"/>
        <field name="subject">Application Received - {{ object.reference }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Dear <t t-out="object.name"/>,</p>
                <p>Your admission application has been received.</p>
                <p>Reference: <t t-out="object.notes or ''"/></p>
            </div>
        </field>
    </record>
    
    <record id="view_school_admission_tree" model="ir.ui.view">
        <field name="name">school.admission.list</field>
        <field name="model">school.admission</field>
        <field name="arch" type="xml">
            <list string="Admission Applications">
                <field name="reference"/>
                <field name="name"/>
                <field name="email"/>
                <field name="program_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    
    <record id="view_school_admission_form" model="ir.ui.view">
        <field name="name">school.admission.form</field>
        <field name="model">school.admission</field>
        <field name="arch" type="xml">
            <form string="Admission Application">
                <header>
                    <button name="action_submit" string="Submit Application" 
                            type="object" class="oe_highlight" 
                            invisible="state != 'draft'"/>
                    <button name="action_under_review" string="Move to Review" 
                            type="object" class="oe_highlight" 
                            invisible="state != 'submitted'"/>
                    <button name="action_accept" string="Accept" 
                            type="object" class="oe_highlight" 
                            invisible="state != 'under_review'"/>
                    <button name="action_reject" string="Reject" 
                            type="object" 
                            invisible="state != 'under_review'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" 
                            type="object" 
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,submitted,under_review,accepted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <div class="oe_title">
                            <h1>
                                <field name="reference" readonly="1"/>
                            </h1>
                        </div>
                    </div>
                    
                    <group>
                        <group string="Personal Information">
                            <field name="name" placeholder="Full Name"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="national_id"/>
                        </group>
                        <group string="Academic Information">
                            <field name="program_id" options="{'no_create': True}"/>
                            <field name="previous_school"/>
                            <field name="gpa"/>
                            <field name="application_date" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Documents">
                        <field name="transcript_filename" invisible="1"/>
                        <field name="transcript_document" filename="transcript_filename"/>
                    </group>
                    
                    <group string="Additional Notes">
                        <field name="notes" nolabel="1" placeholder="Enter any additional information..."/>
                    </group>
                </sheet>
                <chatter/>
                <!-- <div class="oe_chatter"> -->
                    <!-- <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
            </form>
        </field>
    </record>
    <!-- Search View -->
    <record id="view_school_admission_search" model="ir.ui.view">
        <field name="name">school.admission.search</field>
        <field name="model">school.admission</field>
        <field name="arch" type="xml">
            <search string="Search Admissions">
                <field name="name"/>
                <field name="reference"/>
                <field name="email"/>
            </search>
        </field>
    </record>
    
    <record id="action_school_admission" model="ir.actions.act_window">
        <field name="name">Admission Applications</field>
        <field name="res_model">school.admission</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first admission application
            </p>
            <p>
                Track and manage student admission applications from the website.
            </p>
        </field>
    </record>
    
    <record id="view_school_program_tree" model="ir.ui.view">
        <field name="name">school.program.tree</field>
        <field name="model">school.program</field>
        <field name="arch" type="xml">
            <list string="Programs">
                <field name="name"/>
                <field name="code"/>
                <field name="duration"/>
                <field name="admission_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <record id="view_school_program_form" model="ir.ui.view">
        <field name="name">school.program.form</field>
        <field name="model">school.program</field>
        <field name="arch" type="xml">
            <form string="Program">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="duration"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_school_program" model="ir.actions.act_window">
        <field name="name">Programs</field>
        <field name="res_model">school.program</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first academic program
            </p>
            <p>
                Define the academic programs available for admission.
            </p>
        </field>
    </record>
    
    <menuitem id="menu_admission_root" 
              name="Admissions" 
              sequence="30"
              web_icon="admission_portal,static/description/icon.png"/>
    
    <menuitem id="menu_admission_applications" 
              name="Applications" 
              parent="menu_admission_root" 
              action="action_school_admission" 
              sequence="10"/>
    
    <menuitem id="menu_admission_programs" 
              name="Programs" 
              parent="menu_admission_root" 
              action="action_school_program" 
              sequence="20"/>
    
    <record id="seq_school_admission" model="ir.sequence">
        <field name="name">School Admission</field>
        <field name="code">school.admission</field>
        <field name="prefix">ADM</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
    
</odoo>
