<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================== -->
    <!-- Admin System Management Dashboard             -->
    <!-- ============================================== -->

    <template id="admin_dashboard_template" name="Admin System Management">
        <t t-call="website.layout">
            <div class="container-fluid py-4">
                <!-- Header -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h1 class="mb-3">
                            <i class="fa fa-shield me-2"></i>
                            System Management
                        </h1>
                        
                        <!-- Messages -->
                        <t t-if="request.params.get('message')">
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <t t-if="request.params.get('message') == 'hold_placed'">Registration hold placed on user.</t>
                                <t t-if="request.params.get('message') == 'hold_removed'">Registration hold removed from user.</t>
                                <t t-if="request.params.get('message') == 'officer_role_revoked'">Admission officer role revoked.</t>
                                <t t-if="request.params.get('message') == 'officer_role_granted'">Admission officer role granted.</t>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        </t>
                        <t t-if="request.params.get('error')">
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fa fa-exclamation-circle me-2"></i>
                                <t t-esc="request.params.get('error')"/>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Statistics Cards -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card bg-primary text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="card-subtitle mb-1">Total Students</h6>
                                        <h2 class="mb-0" t-esc="stats['total_students']"/>
                                    </div>
                                    <i class="fa fa-users fa-3x opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-info text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="card-subtitle mb-1">Admission Officers</h6>
                                        <h2 class="mb-0" t-esc="stats['total_officers']"/>
                                    </div>
                                    <i class="fa fa-user-tie fa-3x opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-danger text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="card-subtitle mb-1">Students On Hold</h6>
                                        <h2 class="mb-0" t-esc="stats['students_on_hold']"/>
                                    </div>
                                    <i class="fa fa-ban fa-3x opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- User Management -->
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-dark text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <i class="fa fa-users-cog me-2"></i>
                                        User Management
                                    </h5>
                                </div>
                            </div>
                            <div class="card-body">
                                <!-- Search and Filter -->
                                <form action="/admin/system_management" method="get" class="mb-4">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="fa fa-search"></i></span>
                                                <input type="text" name="search_query" class="form-control" 
                                                       placeholder="Search by name or email..."
                                                       t-att-value="search_query"/>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <select name="filter_type" class="form-select">
                                                <option value="all" t-att-selected="'selected' if filter_type == 'all' else None">All Users</option>
                                                <option value="students" t-att-selected="'selected' if filter_type == 'students' else None">Students Only</option>
                                                <option value="officers" t-att-selected="'selected' if filter_type == 'officers' else None">Officers Only</option>
                                                <option value="on_hold" t-att-selected="'selected' if filter_type == 'on_hold' else None">On Hold</option>
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <button type="submit" class="btn btn-primary w-100">
                                                <i class="fa fa-filter me-1"></i>Filter
                                            </button>
                                        </div>
                                    </div>
                                </form>

                                <!-- Users Table -->
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Roles</th>
                                                <th>Hold Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="users" t-as="target_user">
                                                <tr t-att-class="'table-danger' if target_user.is_on_hold else ''">
                                                    <td>
                                                        <strong t-esc="target_user.name"/>
                                                    </td>
                                                    <td t-esc="target_user.email or target_user.login"/>
                                                    <td>
                                                        <t t-if="student_group in target_user.groups_id">
                                                            <span class="badge bg-primary me-1">Student</span>
                                                        </t>
                                                        <t t-if="officer_group in target_user.groups_id">
                                                            <span class="badge bg-info me-1">Officer</span>
                                                        </t>
                                                    </td>
                                                    <td>
                                                        <t t-if="target_user.is_on_hold">
                                                            <span class="badge bg-danger">
                                                                <i class="fa fa-ban me-1"></i>On Hold
                                                            </span>
                                                            <t t-if="target_user.hold_reason">
                                                                <br/>
                                                                <small class="text-muted" t-esc="target_user.hold_reason[:50]"/>
                                                            </t>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-success">Active</span>
                                                        </t>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <!-- View Details -->
                                                            <a t-attf-href="/admin/user/#{target_user.id}/details" class="btn btn-outline-info" title="View Details">
                                                                <i class="fa fa-eye"></i>
                                                            </a>
                                                            
                                                            <!-- Toggle Hold -->
                                                            <t t-if="target_user.is_on_hold">
                                                                <form t-attf-action="/admin/user/#{target_user.id}/remove_hold" method="post" class="d-inline">
                                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                    <button type="submit" class="btn btn-outline-success" title="Remove Hold">
                                                                        <i class="fa fa-unlock"></i>
                                                                    </button>
                                                                </form>
                                                            </t>
                                                            <t t-else="">
                                                                <a t-attf-href="/admin/user/#{target_user.id}/place_hold" class="btn btn-outline-warning" title="Place Hold">
                                                                    <i class="fa fa-lock"></i>
                                                                </a>
                                                            </t>
                                                            
                                                            <!-- Officer Role Management -->
                                                            <t t-if="officer_group in target_user.groups_id">
                                                                <form t-attf-action="/admin/user/#{target_user.id}/revoke_officer" method="post" class="d-inline">
                                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                    <button type="submit" class="btn btn-outline-danger" title="Revoke Officer Role"
                                                                            onclick="return confirm('Revoke officer role from this user?');">
                                                                        <i class="fa fa-user-minus"></i>
                                                                    </button>
                                                                </form>
                                                            </t>
                                                            <t t-elif="student_group in target_user.groups_id">
                                                                <form t-attf-action="/admin/user/#{target_user.id}/grant_officer" method="post" class="d-inline">
                                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                    <button type="submit" class="btn btn-outline-primary" title="Grant Officer Role">
                                                                        <i class="fa fa-user-plus"></i>
                                                                    </button>
                                                                </form>
                                                            </t>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>

                                <t t-if="not users">
                                    <div class="text-center py-4">
                                        <i class="fa fa-search fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">No users found matching your criteria.</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Place Hold Form -->
    <template id="admin_hold_form_template" name="Place Hold Form">
        <t t-call="website.layout">
            <div class="container py-4">
                <div class="row">
                    <div class="col-lg-6 mx-auto">
                        <div class="card">
                            <div class="card-header bg-warning">
                                <h5 class="mb-0">
                                    <i class="fa fa-lock me-2"></i>
                                    Place Registration Hold
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-info">
                                    <strong>User:</strong> <t t-esc="user.name"/>
                                    <br/>
                                    <strong>Email:</strong> <t t-esc="user.email or user.login"/>
                                </div>
                                
                                <form t-attf-action="/admin/user/#{user.id}/place_hold" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    
                                    <div class="mb-3">
                                        <label class="form-label">Reason for Hold</label>
                                        <textarea name="reason" class="form-control" rows="4" 
                                                  placeholder="Enter the reason for placing this hold..."></textarea>
                                        <div class="form-text">This reason will be visible to the student.</div>
                                    </div>
                                    
                                    <div class="d-flex justify-content-between">
                                        <a href="/admin/system_management" class="btn btn-outline-secondary">
                                            <i class="fa fa-arrow-left me-2"></i>Cancel
                                        </a>
                                        <button type="submit" class="btn btn-warning">
                                            <i class="fa fa-lock me-2"></i>Place Hold
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- User Details Template -->
    <template id="admin_user_details_template" name="User Details">
        <t t-call="website.layout">
            <div class="container py-4">
                <div class="row">
                    <div class="col-lg-8 mx-auto">
                        <div class="card">
                            <div class="card-header bg-dark text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-user me-2"></i>
                                    User Details
                                </h5>
                            </div>
                            <div class="card-body">
                                <!-- User Info -->
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <h4 t-esc="target_user.name"/>
                                        <p class="text-muted" t-esc="target_user.email or target_user.login"/>
                                    </div>
                                    <div class="col-md-6 text-md-end">
                                        <t t-if="is_student">
                                            <span class="badge bg-primary me-1">Student</span>
                                        </t>
                                        <t t-if="is_officer">
                                            <span class="badge bg-info me-1">Admission Officer</span>
                                        </t>
                                        <t t-if="is_admin">
                                            <span class="badge bg-dark me-1">Administrator</span>
                                        </t>
                                        <t t-if="target_user.is_on_hold">
                                            <span class="badge bg-danger">On Hold</span>
                                        </t>
                                    </div>
                                </div>

                                <!-- Hold Information -->
                                <t t-if="target_user.is_on_hold">
                                    <div class="alert alert-danger">
                                        <h6>Registration Hold Active</h6>
                                        <t t-if="target_user.hold_reason">
                                            <p><strong>Reason:</strong> <t t-esc="target_user.hold_reason"/></p>
                                        </t>
                                        <t t-if="target_user.hold_date">
                                            <p><strong>Hold Date:</strong> <t t-esc="target_user.hold_date"/></p>
                                        </t>
                                        <t t-if="target_user.hold_placed_by">
                                            <p><strong>Placed By:</strong> <t t-esc="target_user.hold_placed_by.name"/></p>
                                        </t>
                                    </div>
                                </t>

                                <!-- Course Registrations -->
                                <t t-if="is_student">
                                    <h5 class="mt-4">Course Registrations</h5>
                                    <t t-if="registrations">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Course</th>
                                                    <th>Status</th>
                                                    <th>Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="registrations" t-as="reg">
                                                    <tr t-att-class="'table-secondary' if reg.state == 'dropped' else ''">
                                                        <td>
                                                            [<t t-esc="reg.course_id.code"/>] <t t-esc="reg.course_id.name"/>
                                                        </td>
                                                        <td>
                                                            <t t-if="reg.state == 'enrolled'">
                                                                <span class="badge bg-success">Enrolled</span>
                                                            </t>
                                                            <t t-elif="reg.state == 'dropped'">
                                                                <span class="badge bg-secondary">Dropped</span>
                                                            </t>
                                                            <t t-elif="reg.state == 'waitlisted'">
                                                                <span class="badge bg-warning">Waitlisted</span>
                                                            </t>
                                                        </td>
                                                        <td t-esc="reg.registration_date" t-options='{"widget": "datetime", "format": "MM/dd/yyyy"}'/>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted">No course registrations found.</p>
                                    </t>
                                </t>

                                <!-- Actions -->
                                <div class="d-flex justify-content-between mt-4">
                                    <a href="/admin/system_management" class="btn btn-outline-secondary">
                                        <i class="fa fa-arrow-left me-2"></i>Back to User List
                                    </a>
                                    <div>
                                        <t t-if="target_user.is_on_hold">
                                            <form t-attf-action="/admin/user/#{target_user.id}/remove_hold" method="post" class="d-inline">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <button type="submit" class="btn btn-success">
                                                    <i class="fa fa-unlock me-2"></i>Remove Hold
                                                </button>
                                            </form>
                                        </t>
                                        <t t-else="">
                                            <a t-attf-href="/admin/user/#{target_user.id}/place_hold" class="btn btn-warning">
                                                <i class="fa fa-lock me-2"></i>Place Hold
                                            </a>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
