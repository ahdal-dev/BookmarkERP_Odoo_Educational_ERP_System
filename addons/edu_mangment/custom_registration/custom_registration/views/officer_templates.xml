<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================== -->
    <!-- Officer Registration Management Dashboard     -->
    <!-- ============================================== -->

    <template id="officer_dashboard_template" name="Officer Registration Management">
        <t t-call="website.layout">
            <div class="container-fluid py-4">
                <!-- Header -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h1 class="mb-3">
                            <i class="fa fa-cogs me-2"></i>
                            Registration Management
                        </h1>
                        
                        <!-- Messages -->
                        <t t-if="request.params.get('message')">
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <t t-if="request.params.get('message') == 'course_created'">Course created successfully!</t>
                                <t t-if="request.params.get('message') == 'course_updated'">Course updated successfully!</t>
                                <t t-if="request.params.get('message') == 'course_archived'">Course archived.</t>
                                <t t-if="request.params.get('message') == 'course_unarchived'">Course restored.</t>
                                <t t-if="request.params.get('message') == 'registration_opened'">Registration opened.</t>
                                <t t-if="request.params.get('message') == 'registration_closed'">Registration closed.</t>
                                <t t-if="request.params.get('message') == 'course_added'">Course added to student's schedule.</t>
                                <t t-if="request.params.get('message') == 'course_dropped'">Course dropped from student's schedule.</t>
                                <t t-if="request.params.get('message') == 'course_reenrolled'">Student re-enrolled in course.</t>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        </t>
                        <t t-if="request.params.get('error')">
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fa fa-exclamation-circle me-2"></i>
                                <t t-esc="request.params.get('error')"/>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="row">
                    <!-- Left Column: Course Management -->
                    <div class="col-lg-7">
                        <div class="card mb-4">
                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="fa fa-book me-2"></i>
                                    Course Catalog Management
                                </h5>
                                <a href="/officer/course/create" class="btn btn-light btn-sm">
                                    <i class="fa fa-plus me-1"></i>Add Course
                                </a>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Code</th>
                                                <th>Name</th>
                                                <th>Seats</th>
                                                <th>Registration</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="courses" t-as="course">
                                                <tr t-att-class="'table-secondary' if not course.active else ''">
                                                    <td><strong t-esc="course.code"/></td>
                                                    <td t-esc="course.name"/>
                                                    <td>
                                                        <span t-esc="course.available_seats"/> / <span t-esc="course.total_seats"/>
                                                    </td>
                                                    <td>
                                                        <form action="/officer/course/toggle_registration/{course.id}" t-attf-action="/officer/course/toggle_registration/#{course.id}" method="post" class="d-inline">
                                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                            <button type="submit" t-attf-class="btn btn-sm #{course.registration_open and 'btn-success' or 'btn-outline-secondary'}">
                                                                <t t-if="course.registration_open">
                                                                    <i class="fa fa-check me-1"></i>Open
                                                                </t>
                                                                <t t-else="">
                                                                    <i class="fa fa-times me-1"></i>Closed
                                                                </t>
                                                            </button>
                                                        </form>
                                                    </td>
                                                    <td>
                                                        <t t-if="course.active">
                                                            <span class="badge bg-success">Active</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-secondary">Archived</span>
                                                        </t>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <a t-attf-href="/officer/course/edit/#{course.id}" class="btn btn-outline-primary" title="Edit">
                                                                <i class="fa fa-edit"></i>
                                                            </a>
                                                            <t t-if="course.active">
                                                                <form t-attf-action="/officer/course/archive/#{course.id}" method="post" class="d-inline">
                                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                    <button type="submit" class="btn btn-outline-warning" title="Archive" onclick="return confirm('Archive this course?');">
                                                                        <i class="fa fa-archive"></i>
                                                                    </button>
                                                                </form>
                                                            </t>
                                                            <t t-else="">
                                                                <form t-attf-action="/officer/course/unarchive/#{course.id}" method="post" class="d-inline">
                                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                    <button type="submit" class="btn btn-outline-success" title="Restore">
                                                                        <i class="fa fa-undo"></i>
                                                                    </button>
                                                                </form>
                                                            </t>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Student Management -->
                    <div class="col-lg-5">
                        <!-- Student Search -->
                        <div class="card mb-4">
                            <div class="card-header bg-info text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-search me-2"></i>
                                    Student Search
                                </h5>
                            </div>
                            <div class="card-body">
                                <form action="/officer/registration_management" method="get">
                                    <div class="input-group">
                                        <input type="text" name="search_student" class="form-control" 
                                               placeholder="Search by name or email..." t-att-value="search_student"/>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                </form>
                                
                                <!-- Search Results -->
                                <t t-if="students">
                                    <div class="mt-3">
                                        <h6>Search Results:</h6>
                                        <div class="list-group list-group-flush" style="max-height: 200px; overflow-y: auto;">
                                            <t t-foreach="students" t-as="student">
                                                <a t-attf-href="/officer/registration_management?student_id=#{student.id}" 
                                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                   t-att-class="'list-group-item list-group-item-action active' if selected_student and selected_student.id == student.id else 'list-group-item list-group-item-action'">
                                                    <div>
                                                        <strong t-esc="student.name"/>
                                                        <br/>
                                                        <small t-esc="student.email or student.login"/>
                                                    </div>
                                                    <t t-if="student.is_on_hold">
                                                        <span class="badge bg-danger">On Hold</span>
                                                    </t>
                                                </a>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Selected Student Details -->
                        <t t-if="selected_student">
                            <div class="card mb-4">
                                <div class="card-header bg-secondary text-white">
                                    <h5 class="mb-0">
                                        <i class="fa fa-user me-2"></i>
                                        <t t-esc="selected_student.name"/>
                                        <t t-if="selected_student.is_on_hold">
                                            <span class="badge bg-danger ms-2">On Hold</span>
                                        </t>
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <p><strong>Email:</strong> <t t-esc="selected_student.email or selected_student.login"/></p>
                                    
                                    <!-- Add Course Form -->
                                    <div class="mb-4">
                                        <h6>Add Course to Schedule:</h6>
                                        <form t-attf-action="/officer/student/#{selected_student.id}/add_course" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="input-group">
                                                <select name="course_id" class="form-select" required="">
                                                    <option value="">Select a course...</option>
                                                    <t t-foreach="courses" t-as="course">
                                                        <t t-if="course.active">
                                                            <option t-att-value="course.id">
                                                                [<t t-esc="course.code"/>] <t t-esc="course.name"/>
                                                            </option>
                                                        </t>
                                                    </t>
                                                </select>
                                                <button type="submit" class="btn btn-success">
                                                    <i class="fa fa-plus me-1"></i>Add
                                                </button>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- Current Registrations -->
                                    <h6>Current Registrations:</h6>
                                    <t t-if="student_registrations">
                                        <ul class="list-group">
                                            <t t-foreach="student_registrations" t-as="reg">
                                                <li class="list-group-item d-flex justify-content-between align-items-center"
                                                    t-att-class="'list-group-item d-flex justify-content-between align-items-center list-group-item-secondary' if reg.state == 'dropped' else 'list-group-item d-flex justify-content-between align-items-center'">
                                                    <div>
                                                        <strong t-esc="reg.course_id.code"/>
                                                        <t t-if="reg.state == 'dropped'">
                                                            <span class="badge bg-secondary ms-1">Dropped</span>
                                                        </t>
                                                        <t t-if="reg.is_officer_override">
                                                            <span class="badge bg-info ms-1">Override</span>
                                                        </t>
                                                        <br/>
                                                        <small t-esc="reg.course_id.name"/>
                                                    </div>
                                                    <div class="btn-group btn-group-sm">
                                                        <t t-if="reg.state == 'enrolled'">
                                                            <form t-attf-action="/officer/student/#{selected_student.id}/drop_course" method="post">
                                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                <input type="hidden" name="registration_id" t-att-value="reg.id"/>
                                                                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Drop this course?');">
                                                                    <i class="fa fa-times"></i> Drop
                                                                </button>
                                                            </form>
                                                        </t>
                                                        <t t-if="reg.state == 'dropped'">
                                                            <form t-attf-action="/officer/student/#{selected_student.id}/reenroll" method="post">
                                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                <input type="hidden" name="registration_id" t-att-value="reg.id"/>
                                                                <button type="submit" class="btn btn-outline-success">
                                                                    <i class="fa fa-undo"></i> Re-enroll
                                                                </button>
                                                            </form>
                                                        </t>
                                                    </div>
                                                </li>
                                            </t>
                                        </ul>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted">No registrations found.</p>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Course Form Template -->
    <template id="officer_course_form_template" name="Course Form">
        <t t-call="website.layout">
            <div class="container py-4">
                <div class="row">
                    <div class="col-lg-8 mx-auto">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-book me-2"></i>
                                    <t t-esc="page_title"/>
                                </h5>
                            </div>
                            <div class="card-body">
                                <form t-att-action="action == 'create' and '/officer/course/create' or '/officer/course/edit/' + str(course.id if course else '')" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">Course Code *</label>
                                            <input type="text" name="code" class="form-control" required=""
                                                   t-att-value="course.code if course else ''"/>
                                        </div>
                                        <div class="col-md-8 mb-3">
                                            <label class="form-label">Course Name *</label>
                                            <input type="text" name="name" class="form-control" required=""
                                                   t-att-value="course.name if course else ''"/>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label">Description</label>
                                        <textarea name="description" class="form-control" rows="3"><t t-if="course" t-esc="course.description or ''"/></textarea>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">Total Seats *</label>
                                            <input type="number" name="total_seats" class="form-control" min="1" required=""
                                                   t-att-value="course.total_seats if course else 30"/>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">Credits</label>
                                            <input type="number" name="credits" class="form-control" min="1"
                                                   t-att-value="course.credits if course else 3"/>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">Add/Drop Deadline</label>
                                            <input type="date" name="add_drop_deadline" class="form-control"
                                                   t-att-value="course.add_drop_deadline if course else ''"/>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Schedule</label>
                                            <input type="text" name="schedule" class="form-control" placeholder="e.g., MWF 10:00-11:00"
                                                   t-att-value="course.schedule if course else ''"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Instructor</label>
                                            <input type="text" name="instructor" class="form-control"
                                                   t-att-value="course.instructor if course else ''"/>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <div class="form-check">
                                                <input type="checkbox" name="registration_open" class="form-check-input" id="registration_open"
                                                       t-att-checked="'checked' if course and course.registration_open else None"/>
                                                <label class="form-check-label" for="registration_open">Registration Open</label>
                                            </div>
                                        </div>
                                        <t t-if="action == 'edit'">
                                            <div class="col-md-6 mb-3">
                                                <div class="form-check">
                                                    <input type="checkbox" name="active" class="form-check-input" id="active"
                                                           t-att-checked="'checked' if course and course.active else None"/>
                                                    <label class="form-check-label" for="active">Active</label>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                    
                                    <div class="d-flex justify-content-between">
                                        <a href="/officer/registration_management" class="btn btn-outline-secondary">
                                            <i class="fa fa-arrow-left me-2"></i>Cancel
                                        </a>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa fa-save me-2"></i>Save Course
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
