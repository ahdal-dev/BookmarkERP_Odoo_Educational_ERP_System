<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================== -->
    <!-- Record Rules for Registration Management      -->
    <!-- ============================================== -->

    <!-- ==================== Course Rules ==================== -->
    
    <!-- Students: Can read all active courses -->
    <record id="course_student_read_rule" model="ir.rule">
        <field name="name">Courses: Students Read Active</field>
        <field name="model_id" ref="model_education_course"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('edu_mang_auth.group_erp_student'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Officers: Full access to all courses -->
    <record id="course_officer_full_rule" model="ir.rule">
        <field name="name">Courses: Officers Full Access</field>
        <field name="model_id" ref="model_education_course"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('edu_mang_auth.group_erp_admission_officer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Admins: Full access to all courses -->
    <record id="course_admin_full_rule" model="ir.rule">
        <field name="name">Courses: Admins Full Access</field>
        <field name="model_id" ref="model_education_course"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('edu_mang_auth.group_erp_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ==================== Cart Rules ==================== -->

    <!-- Students: Can only access their own cart -->
    <record id="cart_student_own_rule" model="ir.rule">
        <field name="name">Cart: Students Own Records Only</field>
        <field name="model_id" ref="model_education_cart"/>
        <field name="domain_force">[('student_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('edu_mang_auth.group_erp_student'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Officers: Can read all carts (for monitoring) -->
    <record id="cart_officer_read_rule" model="ir.rule">
        <field name="name">Cart: Officers Read All</field>
        <field name="model_id" ref="model_education_cart"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('edu_mang_auth.group_erp_admission_officer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Admins: Full access to all carts -->
    <record id="cart_admin_full_rule" model="ir.rule">
        <field name="name">Cart: Admins Full Access</field>
        <field name="model_id" ref="model_education_cart"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('edu_mang_auth.group_erp_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ==================== Registration Rules ==================== -->

    <!-- Students: Can only access their own registrations -->
    <record id="registration_student_own_rule" model="ir.rule">
        <field name="name">Registration: Students Own Records Only</field>
        <field name="model_id" ref="model_education_registration"/>
        <field name="domain_force">[('student_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('edu_mang_auth.group_erp_student'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Officers: Full access to all registrations -->
    <record id="registration_officer_full_rule" model="ir.rule">
        <field name="name">Registration: Officers Full Access</field>
        <field name="model_id" ref="model_education_registration"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('edu_mang_auth.group_erp_admission_officer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Admins: Full access to all registrations -->
    <record id="registration_admin_full_rule" model="ir.rule">
        <field name="name">Registration: Admins Full Access</field>
        <field name="model_id" ref="model_education_registration"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('edu_mang_auth.group_erp_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
