<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================== -->
    <!-- Student Registration Dashboard Template       -->
    <!-- ============================================== -->

    <template id="student_registration_template" name="Student Registration Dashboard">
        <t t-call="website.layout">
            <div class="container py-4">
                <!-- Header -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h1 class="mb-3">
                            <i class="fa fa-graduation-cap me-2"></i>
                            Course Registration
                        </h1>
                        
                        <!-- Hold Status Warning -->
                        <t t-if="is_on_hold">
                            <div class="alert alert-danger" role="alert">
                                <h4 class="alert-heading">
                                    <i class="fa fa-exclamation-triangle me-2"></i>
                                    Account On Hold
                                </h4>
                                <p>Your account is currently on hold and you cannot register for courses.</p>
                                <t t-if="hold_reason">
                                    <p><strong>Reason:</strong> <t t-esc="hold_reason"/></p>
                                </t>
                                <p class="mb-0">Please contact the administration office to resolve this issue.</p>
                            </div>
                        </t>

                        <!-- Messages -->
                        <t t-if="request.params.get('message')">
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <t t-if="request.params.get('message') == 'added_to_cart'">Course added to your cart!</t>
                                <t t-if="request.params.get('message') == 'removed_from_cart'">Course removed from cart.</t>
                                <t t-if="request.params.get('message') == 'registration_success'">Successfully registered for course!</t>
                                <t t-if="request.params.get('message') == 'course_dropped'">Course dropped successfully.</t>
                                <t t-if="request.params.get('message') == 'already_in_cart'">Course is already in your cart.</t>
                                <t t-if="request.params.get('message') == 'already_enrolled'">You are already enrolled in this course.</t>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        </t>
                        <t t-if="request.params.get('error')">
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fa fa-exclamation-circle me-2"></i>
                                <t t-esc="request.params.get('error')"/>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="row">
                    <!-- Left Column: Course Catalog -->
                    <div class="col-lg-8">
                        <div class="card mb-4">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-book me-2"></i>
                                    Course Catalog
                                </h5>
                            </div>
                            <div class="card-body">
                                <t t-if="courses">
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Code</th>
                                                    <th>Course Name</th>
                                                    <th>Schedule</th>
                                                    <th>Seats</th>
                                                    <th>Status</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="courses" t-as="course">
                                                    <tr>
                                                        <td><strong t-esc="course.code"/></td>
                                                        <td>
                                                            <span t-esc="course.name"/>
                                                            <t t-if="course.description">
                                                                <br/>
                                                                <small class="text-muted" t-esc="course.description[:100]"/>
                                                            </t>
                                                        </td>
                                                        <td><span t-esc="course.schedule or 'TBA'"/></td>
                                                        <td>
                                                            <span class="badge" t-attf-class="#{course.available_seats > 5 and 'bg-success' or (course.available_seats > 0 and 'bg-warning' or 'bg-danger')}">
                                                                <t t-esc="course.available_seats"/> / <t t-esc="course.total_seats"/>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <t t-if="course.registration_open">
                                                                <span class="badge bg-success">Open</span>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="badge bg-secondary">Closed</span>
                                                            </t>
                                                        </td>
                                                        <td>
                                                            <t t-if="not is_on_hold">
                                                                <form t-if="course.registration_open and course.available_seats > 0" action="/student/register" method="post" class="d-inline">
                                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                    <input type="hidden" name="course_id" t-att-value="course.id"/>
                                                                    <button type="submit" class="btn btn-sm btn-success">
                                                                        <i class="fa fa-plus me-1"></i>Register
                                                                    </button>
                                                                </form>
                                                                <form action="/student/cart/add" method="post" class="d-inline ms-1">
                                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                    <input type="hidden" name="course_id" t-att-value="course.id"/>
                                                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                                                        <i class="fa fa-heart me-1"></i>Wishlist
                                                                    </button>
                                                                </form>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center py-4">
                                        <i class="fa fa-info-circle fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">No courses available at this time.</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Cart and Schedule -->
                    <div class="col-lg-4">
                        <!-- Wishlist/Cart -->
                        <div class="card mb-4">
                            <div class="card-header bg-warning">
                                <h5 class="mb-0">
                                    <i class="fa fa-heart me-2"></i>
                                    My Wishlist
                                    <span class="badge bg-light text-dark ms-2" t-esc="len(cart_items)"/>
                                </h5>
                            </div>
                            <div class="card-body">
                                <t t-if="cart_items">
                                    <ul class="list-group list-group-flush">
                                        <t t-foreach="cart_items" t-as="item">
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong t-esc="item.course_id.code"/>
                                                    <br/>
                                                    <small t-esc="item.course_id.name"/>
                                                </div>
                                                <div class="btn-group btn-group-sm">
                                                    <t t-if="not is_on_hold and item.course_id.registration_open">
                                                        <form action="/student/register" method="post" class="d-inline">
                                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                            <input type="hidden" name="cart_id" t-att-value="item.id"/>
                                                            <button type="submit" class="btn btn-success btn-sm" title="Register">
                                                                <i class="fa fa-check"></i>
                                                            </button>
                                                        </form>
                                                    </t>
                                                    <form action="/student/cart/remove" method="post" class="d-inline">
                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                        <input type="hidden" name="cart_id" t-att-value="item.id"/>
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove">
                                                            <i class="fa fa-times"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </li>
                                        </t>
                                    </ul>
                                    <t t-if="not is_on_hold and len(cart_items) > 0">
                                        <form action="/student/register/all" method="post" class="mt-3">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-success w-100">
                                                <i class="fa fa-check-circle me-2"></i>
                                                Register All
                                            </button>
                                        </form>
                                    </t>
                                </t>
                                <t t-else="">
                                    <p class="text-muted text-center mb-0">Your wishlist is empty.</p>
                                </t>
                            </div>
                        </div>

                        <!-- My Schedule -->
                        <div class="card">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-calendar me-2"></i>
                                    My Schedule
                                    <span class="badge bg-light text-dark ms-2" t-esc="len(registrations)"/>
                                </h5>
                            </div>
                            <div class="card-body">
                                <t t-if="registrations">
                                    <ul class="list-group list-group-flush">
                                        <t t-foreach="registrations" t-as="reg">
                                            <li class="list-group-item">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <strong t-esc="reg.course_id.code"/>
                                                        <br/>
                                                        <small t-esc="reg.course_id.name"/>
                                                        <br/>
                                                        <small class="text-muted" t-esc="reg.course_id.schedule or 'TBA'"/>
                                                    </div>
                                                    <form action="/student/drop" method="post">
                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                        <input type="hidden" name="registration_id" t-att-value="reg.id"/>
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" 
                                                                onclick="return confirm('Are you sure you want to drop this course?');">
                                                            <i class="fa fa-minus-circle me-1"></i>Drop
                                                        </button>
                                                    </form>
                                                </div>
                                            </li>
                                        </t>
                                    </ul>
                                </t>
                                <t t-else="">
                                    <p class="text-muted text-center mb-0">You are not registered for any courses.</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Student Schedule Page -->
    <template id="student_schedule_template" name="Student Schedule">
        <t t-call="website.layout">
            <div class="container py-4">
                <div class="row mb-4">
                    <div class="col-12">
                        <h1>
                            <i class="fa fa-calendar me-2"></i>
                            My Course Schedule
                        </h1>
                        <a href="/student/registration" class="btn btn-outline-primary">
                            <i class="fa fa-arrow-left me-2"></i>Back to Registration
                        </a>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <t t-if="registrations">
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Course Code</th>
                                            <th>Course Name</th>
                                            <th>Instructor</th>
                                            <th>Schedule</th>
                                            <th>Credits</th>
                                            <th>Registered On</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="registrations" t-as="reg">
                                            <tr>
                                                <td><strong t-esc="reg.course_id.code"/></td>
                                                <td t-esc="reg.course_id.name"/>
                                                <td t-esc="reg.course_id.instructor or 'TBA'"/>
                                                <td t-esc="reg.course_id.schedule or 'TBA'"/>
                                                <td t-esc="reg.course_id.credits"/>
                                                <td t-esc="reg.registration_date" t-options='{"widget": "datetime", "format": "MM/dd/yyyy"}'/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div class="mt-3">
                                <strong>Total Credits: </strong>
                                <span t-esc="sum(r.course_id.credits for r in registrations)"/>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle me-2"></i>
                                You are not registered for any courses yet.
                                <a href="/student/registration" class="alert-link">Browse the course catalog</a>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
