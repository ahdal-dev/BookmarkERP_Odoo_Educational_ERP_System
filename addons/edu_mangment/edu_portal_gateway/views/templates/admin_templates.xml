<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Admin Portal Templates
    ======================
    User management, system configuration, and reporting for administrators
    -->

    <!-- Admin Dashboard -->
    <template id="admin_dashboard" name="Admin Dashboard">
        <t t-set="is_admin" t-value="True"/>
        <t t-set="dashboard_url" t-value="'/edu-portal/admin/dashboard'"/>
        <t t-set="active_menu" t-value="'dashboard'"/>
        <t t-call="edu_portal_gateway.portal_layout">
            
            <!-- Quick Stats -->
            <div class="stats-grid">
                <div class="stat-card stat-primary">
                    <div class="stat-icon">👥</div>
                    <div class="stat-content">
                        <div class="stat-value"><t t-esc="user_stats.get('total', 0)"/></div>
                        <div class="stat-label">Total Users</div>
                    </div>
                    <a href="/edu-portal/admin/users" class="stat-link">Manage →</a>
                </div>
                
                <div class="stat-card stat-info">
                    <div class="stat-icon">🎓</div>
                    <div class="stat-content">
                        <div class="stat-value"><t t-esc="user_stats.get('students', 0)"/></div>
                        <div class="stat-label">Students</div>
                    </div>
                    <a href="/edu-portal/admin/users?role=student" class="stat-link">View →</a>
                </div>
                
                <div class="stat-card stat-success">
                    <div class="stat-icon">📋</div>
                    <div class="stat-content">
                        <div class="stat-value"><t t-esc="admission_stats.get('pending', 0)"/></div>
                        <div class="stat-label">Pending Applications</div>
                    </div>
                </div>
                
                <div class="stat-card stat-warning">
                    <div class="stat-icon">📝</div>
                    <div class="stat-content">
                        <div class="stat-value"><t t-esc="petition_stats.get('pending', 0)"/></div>
                        <div class="stat-label">Pending Petitions</div>
                    </div>
                </div>
            </div>
            
            <!-- System Overview -->
            <div class="dashboard-columns">
                <div class="dashboard-column">
                    <div class="section">
                        <h2 class="section-title">Registration Overview</h2>
                        <div class="overview-stats">
                            <div class="overview-item">
                                <span class="overview-label">Total Enrollments</span>
                                <span class="overview-value"><t t-esc="registration_stats.get('total_enrolled', 0)"/></span>
                            </div>
                            <div class="overview-item">
                                <span class="overview-label">Active Courses</span>
                                <span class="overview-value"><t t-esc="registration_stats.get('total_courses', 0)"/></span>
                            </div>
                            <div class="overview-item">
                                <span class="overview-label">Registration Open</span>
                                <span class="overview-value"><t t-esc="registration_stats.get('open_registration', 0)"/></span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="dashboard-column">
                    <div class="section">
                        <h2 class="section-title">Quick Actions</h2>
                        <div class="action-grid">
                            <a href="/edu-portal/admin/users/create" class="action-card">
                                <span class="action-icon">➕</span>
                                <span class="action-text">Create User</span>
                            </a>
                            <a href="/edu-portal/admin/settings" class="action-card">
                                <span class="action-icon">⚙️</span>
                                <span class="action-text">System Settings</span>
                            </a>
                            <a href="/edu-portal/admin/courses" class="action-card">
                                <span class="action-icon">📚</span>
                                <span class="action-text">Manage Courses</span>
                            </a>
                            <a t-att-href="backend_url" class="action-card">
                                <span class="action-icon">🖥️</span>
                                <span class="action-text">Odoo Backend</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- User Breakdown -->
            <div class="section">
                <h2 class="section-title">User Breakdown</h2>
                <div class="user-breakdown">
                    <div class="breakdown-item">
                        <div class="breakdown-bar">
                            <div class="breakdown-fill students" t-attf-style="width: #{int(user_stats.get('students', 0) / max(user_stats.get('total', 1), 1) * 100)}%"></div>
                        </div>
                        <div class="breakdown-info">
                            <span class="breakdown-label">Students</span>
                            <span class="breakdown-value"><t t-esc="user_stats.get('students', 0)"/></span>
                        </div>
                    </div>
                    <div class="breakdown-item">
                        <div class="breakdown-bar">
                            <div class="breakdown-fill officers" t-attf-style="width: #{int(user_stats.get('officers', 0) / max(user_stats.get('total', 1), 1) * 100)}%"></div>
                        </div>
                        <div class="breakdown-info">
                            <span class="breakdown-label">Officers</span>
                            <span class="breakdown-value"><t t-esc="user_stats.get('officers', 0)"/></span>
                        </div>
                    </div>
                    <div class="breakdown-item">
                        <div class="breakdown-bar">
                            <div class="breakdown-fill admins" t-attf-style="width: #{int(user_stats.get('admins', 0) / max(user_stats.get('total', 1), 1) * 100)}%"></div>
                        </div>
                        <div class="breakdown-info">
                            <span class="breakdown-label">Admins</span>
                            <span class="breakdown-value"><t t-esc="user_stats.get('admins', 0)"/></span>
                        </div>
                    </div>
                </div>
            </div>
            
        </t>
    </template>

    <!-- User Management List -->
    <template id="admin_users_list" name="User Management">
        <t t-set="is_admin" t-value="True"/>
        <t t-set="dashboard_url" t-value="'/edu-portal/admin/dashboard'"/>
        <t t-set="active_menu" t-value="'users'"/>
        <t t-call="edu_portal_gateway.portal_layout">
            
            <!-- Header Actions -->
            <div class="page-actions">
                <a href="/edu-portal/admin/users/create" class="btn btn-primary">
                    <span>+</span> Create User
                </a>
            </div>
            
            <!-- Search and Filters -->
            <div class="filter-bar">
                <form action="/edu-portal/admin/users" method="get" class="filter-form">
                    <input type="text" name="search" class="filter-input" 
                           placeholder="Search by name, email, or login..."
                           t-att-value="search"/>
                    <select name="role" class="filter-select">
                        <option value="">All Roles</option>
                        <option value="student" t-att-selected="current_role == 'student'">Students</option>
                        <option value="officer" t-att-selected="current_role == 'officer'">Officers</option>
                        <option value="admin" t-att-selected="current_role == 'admin'">Admins</option>
                    </select>
                    <select name="status" class="filter-select">
                        <option value="">All Status</option>
                        <option value="active" t-att-selected="current_status == 'active'">Active</option>
                        <option value="inactive" t-att-selected="current_status == 'inactive'">Inactive</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Filter</button>
                </form>
            </div>
            
            <!-- Role Tabs -->
            <div class="filter-tabs">
                <a href="/edu-portal/admin/users" 
                   t-attf-class="filter-tab #{current_role in ['', 'all'] and 'active' or ''}">
                    All <span class="badge"><t t-esc="role_counts.get('all', 0)"/></span>
                </a>
                <a href="/edu-portal/admin/users?role=student" 
                   t-attf-class="filter-tab #{current_role == 'student' and 'active' or ''}">
                    Students <span class="badge"><t t-esc="role_counts.get('student', 0)"/></span>
                </a>
                <a href="/edu-portal/admin/users?role=officer" 
                   t-attf-class="filter-tab #{current_role == 'officer' and 'active' or ''}">
                    Officers <span class="badge"><t t-esc="role_counts.get('officer', 0)"/></span>
                </a>
                <a href="/edu-portal/admin/users?role=admin" 
                   t-attf-class="filter-tab #{current_role == 'admin' and 'active' or ''}">
                    Admins <span class="badge"><t t-esc="role_counts.get('admin', 0)"/></span>
                </a>
            </div>
            
            <!-- Users Table -->
            <t t-if="users">
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="users" t-as="u">
                                <tr>
                                    <td class="avatar-cell">
                                        <div class="table-avatar">
                                            <t t-esc="u.name[:2].upper() if u.name else '??'"/>
                                        </div>
                                    </td>
                                    <td>
                                        <a t-attf-href="/edu-portal/admin/users/#{u.id}">
                                            <t t-esc="u.name"/>
                                        </a>
                                    </td>
                                    <td><t t-esc="u.email or u.login"/></td>
                                    <td>
                                        <t t-foreach="available_groups" t-as="grp">
                                            <t t-if="request.env.ref(grp.get('xml_id')) in u.group_ids">
                                                <span class="role-badge"><t t-esc="grp.get('name')"/></span>
                                            </t>
                                        </t>
                                    </td>
                                    <td>
                                        <t t-if="u.active">
                                            <span class="status-badge status-active">Active</span>
                                        </t>
                                        <t t-else="">
                                            <span class="status-badge status-inactive">Inactive</span>
                                        </t>
                                    </td>
                                    <td>
                                        <a t-attf-href="/edu-portal/admin/users/#{u.id}" class="btn btn-sm">Manage</a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                
                <!-- Pagination -->
                <t t-if="total_pages > 1">
                    <div class="pagination">
                        <t t-if="page > 1">
                            <a t-attf-href="/edu-portal/admin/users?page=#{page - 1}&amp;role=#{current_role}&amp;search=#{search}" class="page-link">← Previous</a>
                        </t>
                        <span class="page-info">Page <t t-esc="page"/> of <t t-esc="total_pages"/> (<t t-esc="total"/> total)</span>
                        <t t-if="page &lt; total_pages">
                            <a t-attf-href="/edu-portal/admin/users?page=#{page + 1}&amp;role=#{current_role}&amp;search=#{search}" class="page-link">Next →</a>
                        </t>
                    </div>
                </t>
            </t>
            <t t-else="">
                <div class="empty-state">
                    <div class="empty-icon">👥</div>
                    <h3>No Users Found</h3>
                    <p>Try adjusting your filters or <a href="/edu-portal/admin/users/create">create a new user</a>.</p>
                </div>
            </t>
            
        </t>
    </template>

    <!-- User Detail -->
    <template id="admin_user_detail" name="User Detail">
        <t t-set="is_admin" t-value="True"/>
        <t t-set="dashboard_url" t-value="'/edu-portal/admin/dashboard'"/>
        <t t-set="active_menu" t-value="'users'"/>
        <t t-call="edu_portal_gateway.portal_layout">
            
            <div class="detail-container">
                <div class="detail-card">
                    <div class="detail-header">
                        <div class="user-profile">
                            <div class="profile-avatar large">
                                <t t-esc="target_user.name[:2].upper() if target_user.name else '??'"/>
                            </div>
                            <div>
                                <h2><t t-esc="target_user.name"/></h2>
                                <p class="detail-ref"><t t-esc="target_user.login"/></p>
                            </div>
                        </div>
                        <div class="status-badges">
                            <t t-if="target_user.active">
                                <span class="status-badge status-active">Active</span>
                            </t>
                            <t t-else="">
                                <span class="status-badge status-inactive">Inactive</span>
                            </t>
                            <t t-if="is_on_hold">
                                <span class="status-badge status-hold">On Hold</span>
                            </t>
                        </div>
                    </div>
                    
                    <form t-attf-action="/edu-portal/admin/users/#{target_user.id}/update" method="post" class="user-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        
                        <div class="form-section">
                            <h3>Basic Information</h3>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="name">Name</label>
                                    <input type="text" id="name" name="name" class="form-input" 
                                           t-att-value="target_user.name"/>
                                </div>
                                <div class="form-group">
                                    <label for="email">Email</label>
                                    <input type="email" id="email" name="email" class="form-input" 
                                           t-att-value="target_user.email"/>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-section">
                            <h3>Status</h3>
                            <div class="form-grid">
                                <div class="form-group checkbox-group">
                                    <label>
                                        <input type="checkbox" name="active" t-att-checked="target_user.active"/>
                                        <span>Active Account</span>
                                    </label>
                                </div>
                                <div class="form-group checkbox-group">
                                    <label>
                                        <input type="checkbox" name="is_on_hold" t-att-checked="is_on_hold"/>
                                        <span>On Hold (Restrict Registration)</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-section">
                            <h3>Role Assignment</h3>
                            <div class="role-checkboxes">
                                <t t-foreach="available_groups" t-as="grp">
                                    <label class="role-checkbox">
                                        <input type="checkbox" name="group_ids" 
                                               t-att-value="grp.get('id')"
                                               t-att-checked="grp.get('selected')"/>
                                        <span class="role-name"><t t-esc="grp.get('name')"/></span>
                                    </label>
                                </t>
                            </div>
                        </div>
                        
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a href="/edu-portal/admin/users" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
            
        </t>
    </template>

    <!-- Create User -->
    <template id="admin_user_create" name="Create User">
        <t t-set="is_admin" t-value="True"/>
        <t t-set="dashboard_url" t-value="'/edu-portal/admin/dashboard'"/>
        <t t-set="active_menu" t-value="'users'"/>
        <t t-call="edu_portal_gateway.portal_layout">
            
            <div class="form-container">
                <div class="form-card">
                    <h2 class="form-title">Create New User</h2>
                    
                    <form action="/edu-portal/admin/users/create/submit" method="post" class="user-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        
                        <div class="form-section">
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="name">Name *</label>
                                    <input type="text" id="name" name="name" class="form-input" required="required"/>
                                </div>
                                <div class="form-group">
                                    <label for="login">Login/Username *</label>
                                    <input type="text" id="login" name="login" class="form-input" required="required"/>
                                </div>
                                <div class="form-group">
                                    <label for="email">Email</label>
                                    <input type="email" id="email" name="email" class="form-input"/>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-section">
                            <h3>Role Assignment</h3>
                            <div class="role-checkboxes">
                                <t t-foreach="available_groups" t-as="grp">
                                    <label class="role-checkbox">
                                        <input type="checkbox" name="group_ids" t-att-value="grp.get('id')"/>
                                        <span class="role-name"><t t-esc="grp.get('name')"/></span>
                                    </label>
                                </t>
                            </div>
                        </div>
                        
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">Create User</button>
                            <a href="/edu-portal/admin/users" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
            
        </t>
    </template>

    <!-- System Settings -->
    <template id="admin_settings" name="System Settings">
        <t t-set="is_admin" t-value="True"/>
        <t t-set="dashboard_url" t-value="'/edu-portal/admin/dashboard'"/>
        <t t-set="active_menu" t-value="'settings'"/>
        <t t-call="edu_portal_gateway.portal_layout">
            
            <div class="settings-container">
                <form action="/edu-portal/admin/settings/save" method="post" class="settings-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    
                    <!-- Admission Rules -->
                    <div class="settings-section">
                        <div class="settings-header">
                            <h3>📋 Admission Rules</h3>
                        </div>
                        <div class="settings-grid">
                            <div class="form-group">
                                <label for="min_gpa_requirement">Minimum GPA Requirement</label>
                                <div class="input-row">
                                    <input type="number" id="min_gpa_requirement" name="min_gpa_requirement" 
                                           class="form-input" step="0.1" min="0" max="4"
                                           t-att-value="settings.get('min_gpa_requirement', '3.0')"/>
                                    <span class="input-suffix">/ 4.0</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Registration Rules -->
                    <div class="settings-section">
                        <div class="settings-header">
                            <h3>📚 Registration Rules</h3>
                        </div>
                        <div class="settings-grid">
                            <div class="form-group">
                                <label for="max_credits_per_semester">Max Credits per Semester</label>
                                <input type="number" id="max_credits_per_semester" name="max_credits_per_semester" 
                                       class="form-input" min="1" max="30"
                                       t-att-value="settings.get('max_credits_per_semester', '18')"/>
                            </div>
                            <div class="form-group">
                                <label for="add_drop_period_days">Add/Drop Period (Days)</label>
                                <input type="number" id="add_drop_period_days" name="add_drop_period_days" 
                                       class="form-input" min="1" max="30"
                                       t-att-value="settings.get('add_drop_period_days', '14')"/>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Email Configuration -->
                    <div class="settings-section">
                        <div class="settings-header">
                            <h3>✉️ Email/Mailbox Configuration</h3>
                        </div>
                        <div class="settings-grid">
                            <div class="form-group">
                                <label for="mailbox_domain">Email Domain</label>
                                <input type="text" id="mailbox_domain" name="mailbox_domain" 
                                       class="form-input" placeholder="school.edu"
                                       t-att-value="settings.get('mailbox_domain', 'school.edu')"/>
                            </div>
                            <div class="form-group">
                                <label for="mailbox_provider">Mailbox Provider</label>
                                <select id="mailbox_provider" name="mailbox_provider" class="form-select">
                                    <option value="none" t-att-selected="settings.get('mailbox_provider') == 'none'">None (No external provisioning)</option>
                                    <option value="http" t-att-selected="settings.get('mailbox_provider') == 'http'">HTTP API</option>
                                </select>
                            </div>
                            <div class="form-group full-width">
                                <label for="api_base_url">API Base URL (for HTTP provider)</label>
                                <input type="url" id="api_base_url" name="api_base_url" 
                                       class="form-input" placeholder="https://api.mailservice.com"
                                       t-att-value="settings.get('api_base_url', '')"/>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">💾 Save Settings</button>
                        <a href="/edu-portal/admin/dashboard" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
            
        </t>
    </template>

    <!-- Registration Windows -->
    <template id="admin_registration_windows" name="Registration Windows">
        <t t-set="is_admin" t-value="True"/>
        <t t-set="dashboard_url" t-value="'/edu-portal/admin/dashboard'"/>
        <t t-set="active_menu" t-value="'settings'"/>
        <t t-call="edu_portal_gateway.portal_layout">
            
            <div class="section">
                <div class="section-header">
                    <h2 class="section-title">Registration Windows</h2>
                    <p class="section-description">
                        Configure priority-based registration time slots for different student groups.
                    </p>
                </div>
                
                <div class="info-box">
                    <p>📌 Registration windows are currently managed at the course level. 
                    Set registration start/end dates on individual courses through the 
                    <a href="/edu-portal/admin/courses">Courses</a> page.</p>
                </div>
                
                <t t-if="courses_with_dates">
                    <h3>Courses with Registration Dates</h3>
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Course</th>
                                    <th>Registration Start</th>
                                    <th>Registration End</th>
                                    <th>Add/Drop Deadline</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="courses_with_dates" t-as="course">
                                    <tr>
                                        <td><t t-esc="course.code"/> - <t t-esc="course.name"/></td>
                                        <td><t t-esc="course.registration_start" t-options='{"widget": "date"}'/></td>
                                        <td><t t-esc="course.registration_end" t-options='{"widget": "date"}'/></td>
                                        <td><t t-esc="course.add_drop_deadline" t-options='{"widget": "date"}'/></td>
                                        <td>
                                            <t t-if="course.registration_open">
                                                <span class="status-badge status-open">Open</span>
                                            </t>
                                            <t t-else="">
                                                <span class="status-badge status-closed">Closed</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>
            
        </t>
    </template>

    <!-- Course Management -->
    <template id="admin_courses_list" name="Course Management">
        <t t-set="is_admin" t-value="True"/>
        <t t-set="dashboard_url" t-value="'/edu-portal/admin/dashboard'"/>
        <t t-set="active_menu" t-value="'courses'"/>
        <t t-call="edu_portal_gateway.portal_layout">
            
            <!-- Search -->
            <div class="search-bar">
                <form action="/edu-portal/admin/courses" method="get" class="search-form">
                    <input type="text" name="search" class="search-input" 
                           placeholder="Search by name or code..."
                           t-att-value="search"/>
                    <select name="semester" class="filter-select">
                        <option value="">All Semesters</option>
                        <option value="fall" t-att-selected="semester == 'fall'">Fall</option>
                        <option value="spring" t-att-selected="semester == 'spring'">Spring</option>
                        <option value="summer" t-att-selected="semester == 'summer'">Summer</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Search</button>
                </form>
            </div>
            
            <!-- Courses Table -->
            <t t-if="courses">
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Credits</th>
                                <th>Seats</th>
                                <th>Semester</th>
                                <th>Registration</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="courses" t-as="course">
                                <tr>
                                    <td><strong><t t-esc="course.code"/></strong></td>
                                    <td><t t-esc="course.name"/></td>
                                    <td><t t-esc="course.credits"/></td>
                                    <td>
                                        <t t-esc="course.available_seats"/> / <t t-esc="course.total_seats"/>
                                    </td>
                                    <td><t t-esc="course.semester"/></td>
                                    <td>
                                        <t t-if="course.registration_open">
                                            <span class="status-badge status-open">Open</span>
                                        </t>
                                        <t t-else="">
                                            <span class="status-badge status-closed">Closed</span>
                                        </t>
                                    </td>
                                    <td class="action-cell">
                                        <form t-attf-action="/edu-portal/admin/courses/#{course.id}/toggle-registration" method="post" style="display: inline;">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <t t-if="course.registration_open">
                                                <button type="submit" class="btn btn-sm btn-warning">Close</button>
                                            </t>
                                            <t t-else="">
                                                <button type="submit" class="btn btn-sm btn-success">Open</button>
                                            </t>
                                        </form>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                
                <!-- Pagination -->
                <t t-if="total_pages > 1">
                    <div class="pagination">
                        <t t-if="page > 1">
                            <a t-attf-href="/edu-portal/admin/courses?page=#{page - 1}&amp;search=#{search}" class="page-link">← Previous</a>
                        </t>
                        <span class="page-info">Page <t t-esc="page"/> of <t t-esc="total_pages"/></span>
                        <t t-if="page &lt; total_pages">
                            <a t-attf-href="/edu-portal/admin/courses?page=#{page + 1}&amp;search=#{search}" class="page-link">Next →</a>
                        </t>
                    </div>
                </t>
            </t>
            <t t-else="">
                <div class="empty-state">
                    <div class="empty-icon">📚</div>
                    <h3>No Courses Found</h3>
                    <p>Try adjusting your search criteria.</p>
                </div>
            </t>
            
        </t>
    </template>

    <!-- Reports -->
    <template id="admin_reports" name="Reports &amp; Analytics">
        <t t-set="is_admin" t-value="True"/>
        <t t-set="dashboard_url" t-value="'/edu-portal/admin/dashboard'"/>
        <t t-set="active_menu" t-value="'reports'"/>
        <t t-call="edu_portal_gateway.portal_layout">
            
            <!-- Recent Activity Stats -->
            <div class="section">
                <h2 class="section-title">Activity (Last 30 Days)</h2>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon">📋</div>
                        <div class="stat-content">
                            <div class="stat-value"><t t-esc="recent_stats.get('admissions', 0)"/></div>
                            <div class="stat-label">New Applications</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">✅</div>
                        <div class="stat-content">
                            <div class="stat-value"><t t-esc="recent_stats.get('registrations', 0)"/></div>
                            <div class="stat-label">New Registrations</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">📝</div>
                        <div class="stat-content">
                            <div class="stat-value"><t t-esc="recent_stats.get('petitions', 0)"/></div>
                            <div class="stat-label">New Petitions</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Admissions by Program -->
            <t t-if="admission_by_program">
                <div class="section">
                    <h2 class="section-title">Applications by Program</h2>
                    <div class="chart-container">
                        <t t-foreach="admission_by_program" t-as="item">
                            <div class="chart-bar-item">
                                <span class="chart-label"><t t-esc="item.get('name')"/></span>
                                <div class="chart-bar">
                                    <div class="chart-bar-fill" t-attf-style="width: #{min(item.get('count', 0) * 2, 100)}%"></div>
                                </div>
                                <span class="chart-value"><t t-esc="item.get('count')"/></span>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
            
        </t>
    </template>

</odoo>
