<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record id="view_petition_type_list" model="ir.ui.view">
            <field name="name">petition.type.list</field>
            <field name="model">petition.type</field>
            <field name="arch" type="xml">
                <list string="Petition Types" multi_edit="1">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="requires_approval"/>
                    <field name="max_duration_days"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_petition_type_form" model="ir.ui.view">
            <field name="name">petition.type.form</field>
            <field name="model">petition.type</field>
            <field name="arch" type="xml">
                <form string="Petition Type">
                    <sheet>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="requires_approval"/>
                                <field name="max_duration_days"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" nolabel="1" widget="html"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_petition_type_search" model="ir.ui.view">
            <field name="name">petition.type.search</field>
            <field name="model">petition.type</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <filter string="Active" name="active" domain="[('active','=',True)]"/>
                    <filter string="Requires Approval" name="requires_approval" domain="[('requires_approval','=',True)]"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_petition_type" model="ir.actions.act_window">
            <field name="name">Petition Types</field>
            <field name="res_model">petition.type</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_petition_type_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first petition type
                </p>
                <p>
                    Define different types of petitions that students can submit.
                </p>
            </field>
        </record>
    </data>
</odoo>
