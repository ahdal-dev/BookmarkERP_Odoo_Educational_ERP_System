<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= List View ================= -->
    <record id="view_chatbot_rag_document_list" model="ir.ui.view">
        <field name="name">chatbot.rag.document.list</field>
        <field name="model">chatbot.rag.document</field>
        <field name="arch" type="xml">
            <list string="RAG Documents">
                <field name="name"/>
                <field name="filename"/>
                <field name="filetype"/>
                <field name="chunk_count"/>
                <field name="sync_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'synced'"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- ================= Form View ================= -->
    <record id="view_chatbot_rag_document_form" model="ir.ui.view">
        <field name="name">chatbot.rag.document.form</field>
        <field name="model">chatbot.rag.document</field>
        <field name="arch" type="xml">
            <form string="RAG Document">
                <header>
                    <button name="action_sync" string="Sync to Backend" type="object"
                            class="oe_highlight"/>
                    <button name="action_delete_from_backend" string="Remove from Backend"
                            type="object"
                            confirm="Remove this document and its embeddings from the chatbot backend?"
                            invisible="state != 'synced'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,synced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Document title"/>
                        </h1>
                    </div>
                    <group>
                        <group string="File">
                            <field name="attachment" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="filetype"/>
                        </group>
                        <group string="Backend Status">
                            <field name="rag_document_id" readonly="1"/>
                            <field name="chunk_count" readonly="1"/>
                            <field name="sync_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= Search View ================= -->
    <record id="view_chatbot_rag_document_search" model="ir.ui.view">
        <field name="name">chatbot.rag.document.search</field>
        <field name="model">chatbot.rag.document</field>
        <field name="arch" type="xml">
            <search string="Search RAG Documents">
                <field name="name"/>
                <field name="filename"/>
                <filter string="Synced" name="synced" domain="[('state', '=', 'synced')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="File Type" name="group_filetype" context="{'group_by': 'filetype'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================= Action ================= -->
    <record id="action_chatbot_rag_document" model="ir.actions.act_window">
        <field name="name">RAG Documents</field>
        <field name="res_model">chatbot.rag.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_chatbot_rag_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload a knowledge-base document
            </p>
            <p>
                Upload PDF, TXT, DOCX or CSV files and sync them to the chatbot
                backend so the RAG pipeline can chunk and embed them.
            </p>
        </field>
    </record>

</odoo>
