<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_service_account_rotation" model="ir.cron">
        <field name="name">Security: rotate service-account credentials</field>
        <field name="model_id" ref="model_service_account"/>
        <field name="state">code</field>
        <field name="code">model.cron_rotate_due()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
        <field name="priority">120</field>
    </record>
</odoo>
