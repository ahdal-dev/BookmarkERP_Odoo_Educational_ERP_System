<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================= -->
    <!-- Custom Educational ERP Login Page (Standalone)    -->
    <!-- ================================================= -->
    <template id="edu_login_page" name="Educational ERP Login">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Educational ERP - Login</title>
                <link rel="stylesheet" href="/web/static/lib/bootstrap/css/bootstrap.css"/>
                <link rel="stylesheet" href="/web/static/lib/fontawesome/css/fontawesome.css"/>
                <link rel="stylesheet" href="/web/static/lib/fontawesome/css/solid.css"/>
                <style>
                    body {
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        min-height: 100vh;
                    }
                    .edu-login-card {
                        background: white;
                        border-radius: 15px;
                        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
                        padding: 40px;
                    }
                    .edu-logo-circle {
                        width: 80px;
                        height: 80px;
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        margin: 0 auto;
                    }
                    .edu-logo-circle i {
                        color: white;
                    }
                    .btn-primary {
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        border: none;
                    }
                    .btn-primary:hover {
                        background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
                    }
                </style>
            </head>
            <body>
                <div class="container">
                    <div class="row justify-content-center align-items-center min-vh-100">
                        <div class="col-md-6 col-lg-5">
                            <div class="edu-login-card">
                                <!-- Logo and Header -->
                                <div class="text-center mb-4">
                                    <div class="edu-logo-circle">
                                        <i class="fa-solid fa-graduation-cap fa-2x"></i>
                                    </div>
                                    <h2 class="mt-3 mb-1">Educational ERP</h2>
                                    <p class="text-muted">Welcome back! Please sign in to continue.</p>
                                </div>

                                <!-- Error Messages -->
                                <t t-if="error">
                                    <div class="alert alert-danger" role="alert">
                                        <i class="fa-solid fa-circle-exclamation me-2"></i>
                                        <t t-if="error == 'session_expired'">
                                            Your session has expired. Please log in again.
                                        </t>
                                        <t t-elif="error == 'access_denied'">
                                            Access denied. Please check your credentials.
                                        </t>
                                        <t t-else="">
                                            <t t-esc="error"/>
                                        </t>
                                    </div>
                                </t>

                                <!-- Login Form -->
                                <form action="/web/login" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                                    <input type="hidden" name="redirect" t-att-value="redirect"/>

                                    <div class="mb-3">
                                        <label for="login" class="form-label">
                                            <i class="fa-solid fa-envelope me-1"></i>Email / Username
                                        </label>
                                        <input type="text"
                                               name="login"
                                               id="login"
                                               class="form-control form-control-lg"
                                               placeholder="Enter your email or username"
                                               t-att-value="login"
                                               required="required"
                                               autofocus="autofocus"/>
                                    </div>

                                    <div class="mb-3">
                                        <label for="password" class="form-label">
                                            <i class="fa-solid fa-lock me-1"></i>Password
                                        </label>
                                        <input type="password"
                                               name="password"
                                               id="password"
                                               class="form-control form-control-lg"
                                               placeholder="Enter your password"
                                               required="required"/>
                                    </div>

                                    <div class="mb-4 d-flex justify-content-between align-items-center">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="rememberMe"/>
                                            <label class="form-check-label" for="rememberMe">
                                                Remember me
                                            </label>
                                        </div>
                                        <a href="/web/reset_password" class="text-decoration-none">
                                            Forgot Password?
                                        </a>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
                                        </button>
                                    </div>
                                </form>

                                <!-- Role-based Quick Info -->
                                <hr class="my-4"/>
                                <div class="text-center">
                                    <p class="text-muted small mb-2">Login based on your role:</p>
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                        <span class="badge bg-info">
                                            <i class="fa-solid fa-user-graduate me-1"></i>Student
                                        </span>
                                        <span class="badge bg-warning text-dark">
                                            <i class="fa-solid fa-user-tie me-1"></i>Officer
                                        </span>
                                        <span class="badge bg-danger">
                                            <i class="fa-solid fa-user-shield me-1"></i>Admin
                                        </span>
                                    </div>
                                </div>

                                <!-- Back to Home -->
                                <div class="text-center mt-4">
                                    <a href="/" class="text-decoration-none">
                                        <i class="fa-solid fa-arrow-left me-1"></i>Back to Home
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </body>
        </html>
    </template>

    <!-- ================================================= -->
    <!-- Access Denied Page Template (Standalone)          -->
    <!-- ================================================= -->
    <template id="access_denied_page" name="Access Denied">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Access Denied</title>
                <link rel="stylesheet" href="/web/static/lib/bootstrap/css/bootstrap.css"/>
                <link rel="stylesheet" href="/web/static/lib/fontawesome/css/fontawesome.css"/>
                <link rel="stylesheet" href="/web/static/lib/fontawesome/css/solid.css"/>
            </head>
            <body class="bg-light">
                <div class="container mt-5 mb-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-6">
                            <div class="card shadow-sm border-danger">
                                <div class="card-body p-5 text-center">
                                    <div class="mb-4">
                                        <i class="fa-solid fa-ban text-danger" style="font-size: 80px;"></i>
                                    </div>
                                    <h1 class="display-5 text-danger mb-3">Access Denied</h1>
                                    <p class="lead mb-4">
                                        <t t-esc="error_message or 'You do not have permission to access this resource.'"/>
                                    </p>
                                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                                        <a href="/edu/login" class="btn btn-primary btn-lg">
                                            <i class="fa-solid fa-right-to-bracket me-2"></i>Login
                                        </a>
                                        <a href="/" class="btn btn-outline-secondary btn-lg">
                                            <i class="fa-solid fa-house me-2"></i>Home
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </body>
        </html>
    </template>

</odoo>
