    },
    {
      "name": "Utility Endpoints",
      "item": [
        {
          "name": "Get Custom Login Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/edu/login",
              "host": ["{{base_url}}"],
              "path": ["edu", "login"]
            },
            "description": "Access the custom educational ERP login page"
          }
        },
        {
          "name": "Session Check (Not Logged In)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('✅ User is not logged in', function () {",
                  "    pm.expect(jsonData.result.logged_in).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {},\n    \"id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/edu/check_session",
              "host": ["{{base_url}}"],
              "path": ["edu", "check_session"]
            }
          }
        },
        {
          "name": "Student Petitions Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/student/petitions",
              "host": ["{{base_url}}"],
              "path": ["student", "petitions"]
            },
            "description": "Access student petitions page (must be logged in as student)"
          }
        },
        {
          "name": "Student Registration Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/student/registration",
              "host": ["{{base_url}}"],
              "path": ["student", "registration"]
