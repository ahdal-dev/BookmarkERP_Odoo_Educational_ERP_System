                                    <div class="edu-user-info text-center p-3">
                                        <div class="edu-avatar mx-auto mb-2">
                                            <i class="fa fa-user-graduate fa-4x text-white"></i>
                                        </div>
                                        <h6 class="text-white mb-0" t-esc="user.name"/>
                                        <span class="badge bg-light text-primary mt-2">Student</span>
                                    </div>
                                    <hr class="text-white-50 mx-3"/>
                                    <ul class="nav flex-column">
                                        <li class="nav-item">
                                            <a class="nav-link text-white" href="/student/dashboard">
                                                <i class="fa fa-home me-2"></i>Dashboard
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-white active" href="/student/petitions">
                                                <i class="fa fa-file-text me-2"></i>Submit Petition
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-white" href="/student/registration">
                                                <i class="fa fa-book me-2"></i>Register for Courses
                                            </a>
                                        </li>
                                    </ul>
                                    <hr class="text-white-50 mx-3"/>
                                    <ul class="nav flex-column">
                                        <li class="nav-item">
                                            <a class="nav-link text-white" href="/edu/logout">
                                                <i class="fa fa-sign-out me-2"></i>Logout
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </nav>

                            <!-- Main Content -->
                            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 edu-main-content">
                                <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
                                    <h1 class="h2"><i class="fa fa-file-text me-2"></i>Submit Petition</h1>
                                    <a href="/student/dashboard" class="btn btn-outline-primary">
                                        <i class="fa fa-arrow-left me-1"></i>Back to Dashboard
                                    </a>
                                </div>

                                <div class="card">
                                    <div class="card-body text-center py-5">
                                        <i class="fa fa-cogs fa-5x text-muted mb-4"></i>
                                        <h3>Petition System</h3>
                                        <p class="text-muted mb-4">
                                            This feature is coming soon. You will be able to submit
                                            academic petitions and track their status here.
                                        </p>
                                        <div class="alert alert-info d-inline-block">
                                            <i class="fa fa-info-circle me-2"></i>
                                            Integration with the Petition module is pending.
                                        </div>
                                    </div>
                                </div>
                            </main>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ================================================= -->
    <!-- STUDENT REGISTRATION PAGE (Placeholder)           -->
    <!-- ================================================= -->
