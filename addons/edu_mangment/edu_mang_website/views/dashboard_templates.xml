    <!-- ================================================= -->
    <!-- ADMISSION OFFICER DASHBOARD                       -->
    <!-- ================================================= -->
    <template id="admission_dashboard" name="Admission Dashboard" customize_show="False">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="edu-dashboard-wrapper">
                    <div class="container-fluid">
                        <div class="row">
                            <!-- Sidebar -->
                            <nav class="col-md-3 col-lg-2 d-md-block edu-sidebar bg-warning">
                                <div class="position-sticky pt-3">
                                    <div class="edu-user-info text-center p-3">
                                        <div class="edu-avatar mx-auto mb-2">
                                            <i class="fa fa-user-tie fa-4x text-dark"></i>
                                        </div>
                                        <h6 class="text-dark mb-0" t-esc="user.name"/>
                                        <small class="text-dark" t-esc="user.login"/>
                                        <span class="badge bg-dark text-warning mt-2">Admission Officer</span>
                                    </div>
                                    <hr class="text-dark mx-3" style="opacity: 0.3;"/>
                                    <ul class="nav flex-column">
                                        <li class="nav-item">
                                            <a class="nav-link text-dark active" href="/admission/dashboard">
                                                <i class="fa fa-home me-2"></i>Dashboard
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" href="/web#model=school.admission">
                                                <i class="fa fa-list me-2"></i>All Applications
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" href="/web">
                                                <i class="fa fa-cog me-2"></i>Backend
                                            </a>
                                        </li>
                                    </ul>
                                    <hr class="text-dark mx-3" style="opacity: 0.3;"/>
                                    <ul class="nav flex-column">
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" href="/edu/logout">
                                                <i class="fa fa-sign-out me-2"></i>Logout
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </nav>

                            <!-- Main Content -->
                            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 edu-main-content">
                                <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
                                    <h1 class="h2"><i class="fa fa-tachometer me-2"></i>Admission Dashboard</h1>
                                    <a href="/web" class="btn btn-warning">
                                        <i class="fa fa-external-link me-1"></i>Open Backend
                                    </a>
                                </div>

                                <!-- Stats Cards -->
                                <div class="row mb-4">
                                    <div class="col-md-3 mb-3">
                                        <div class="card border-primary h-100">
                                            <div class="card-body text-center">
                                                <i class="fa fa-inbox fa-3x text-primary mb-3"></i>
                                                <h3 class="text-primary" t-esc="pending_applications"/>
                                                <p class="text-muted mb-0">Pending</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <div class="card border-info h-100">
                                            <div class="card-body text-center">
                                                <i class="fa fa-eye fa-3x text-info mb-3"></i>
                                                <h3 class="text-info" t-esc="under_review"/>
                                                <p class="text-muted mb-0">Under Review</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <div class="card border-success h-100">
                                            <div class="card-body text-center">
                                                <i class="fa fa-check-circle fa-3x text-success mb-3"></i>
                                                <h3 class="text-success" t-esc="accepted"/>
                                                <p class="text-muted mb-0">Accepted</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <div class="card border-danger h-100">
                                            <div class="card-body text-center">
                                                <i class="fa fa-times-circle fa-3x text-danger mb-3"></i>
                                                <h3 class="text-danger" t-esc="rejected"/>
                                                <p class="text-muted mb-0">Rejected</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Quick Actions -->
                                <div class="card">
                                    <div class="card-header bg-warning text-dark">
                                        <h5 class="mb-0"><i class="fa fa-bolt me-2"></i>Quick Actions</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4 mb-3">
                                                <a href="/web#model=school.admission&amp;view_type=list" class="btn btn-outline-primary btn-lg w-100">
                                                    <i class="fa fa-list me-2"></i>View All Applications
                                                </a>
                                            </div>
                                            <div class="col-md-4 mb-3">
                                                <a href="/admission/apply" class="btn btn-outline-success btn-lg w-100">
                                                    <i class="fa fa-plus me-2"></i>New Application Form
                                                </a>
                                            </div>
                                            <div class="col-md-4 mb-3">
                                                <a href="/web#model=school.program" class="btn btn-outline-info btn-lg w-100">
                                                    <i class="fa fa-graduation-cap me-2"></i>Manage Programs
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </main>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

