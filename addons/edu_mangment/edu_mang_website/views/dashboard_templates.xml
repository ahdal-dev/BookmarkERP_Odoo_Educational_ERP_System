<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================= -->
    <!-- BASE DASHBOARD LAYOUT WITH SIDEBAR                -->
    <!-- ================================================= -->
    <template id="dashboard_layout" name="Dashboard Base Layout">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="edu-dashboard-wrapper">
                    <div class="container-fluid">
                        <div class="row">
                            <!-- Sidebar -->
                            <nav class="col-md-3 col-lg-2 d-md-block edu-sidebar">
                                <div class="position-sticky pt-3">
                                    <!-- User Info -->
                                    <div class="edu-user-info text-center p-3">
                                        <div class="edu-avatar mx-auto mb-2">
                                            <i class="fa fa-user-circle fa-4x text-white"></i>
                                        </div>
                                        <h6 class="text-white mb-0" t-esc="user.name"/>
                                        <small class="text-white-50" t-esc="user.login"/>
                                    </div>

                                    <hr class="text-white-50"/>

                                    <!-- Navigation Menu -->
                                    <ul class="nav flex-column">
                                        <t t-raw="sidebar_content"/>
                                    </ul>

                                    <hr class="text-white-50"/>

                                    <!-- Logout -->
                                    <ul class="nav flex-column">
                                        <li class="nav-item">
                                            <a class="nav-link text-white" href="/edu/logout">
                                                <i class="fa fa-sign-out me-2"></i>
                                                Logout
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </nav>

                            <!-- Main Content -->
                            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 edu-main-content">
                                <!-- Top Bar -->
                                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                                    <h1 class="h2">
                                        <t t-esc="page_name"/>
                                    </h1>
                                    <div class="btn-toolbar mb-2 mb-md-0">
                                        <span class="text-muted">
                                            <i class="fa fa-calendar me-1"></i>
                                            <t t-esc="request.env['res.lang']._lang_get(request.env.user.lang).format('%B %d, %Y')"/>
                                        </span>
                                    </div>
                                </div>

                                <!-- Page Content -->
                                <t t-raw="main_content"/>
                            </main>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ================================================= -->
    <!-- STUDENT DASHBOARD                                 -->
    <!-- ================================================= -->
    <template id="student_dashboard" name="Student Dashboard" customize_show="False">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="edu-dashboard-wrapper">
                    <div class="container-fluid">
                        <div class="row">
                            <!-- Student Sidebar -->
                            <nav class="col-md-3 col-lg-2 d-md-block edu-sidebar bg-primary">
                                <div class="position-sticky pt-3">
                                    <!-- User Info -->
                                    <div class="edu-user-info text-center p-3">
                                        <div class="edu-avatar mx-auto mb-2">
                                            <i class="fa fa-user-graduate fa-4x text-white"></i>
                                        </div>
                                        <h6 class="text-white mb-0" t-esc="student_name"/>
                                        <small class="text-white-50" t-esc="student_email"/>
                                        <span class="badge bg-light text-primary mt-2">Student</span>
                                    </div>

                                    <hr class="text-white-50 mx-3"/>

                                    <!-- Navigation Menu -->
                                    <ul class="nav flex-column">
                                        <li class="nav-item">
                                            <a class="nav-link text-white active" href="/student/dashboard">
                                                <i class="fa fa-home me-2"></i>
                                                Dashboard
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-white" href="/student/petitions">
                                                <i class="fa fa-file-text me-2"></i>
                                                Submit Petition
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-white" href="/student/registration">
                                                <i class="fa fa-book me-2"></i>
                                                Register for Courses
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-white disabled" href="#">
                                                <i class="fa fa-calendar me-2"></i>
                                                My Schedule
                                                <span class="badge bg-secondary ms-1">Soon</span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-white disabled" href="#">
                                                <i class="fa fa-bar-chart me-2"></i>
                                                Grades
                                                <span class="badge bg-secondary ms-1">Soon</span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-white disabled" href="#">
                                                <i class="fa fa-money me-2"></i>
                                                Fees &amp; Payments
                                                <span class="badge bg-secondary ms-1">Soon</span>
                                            </a>
                                        </li>
                                    </ul>

                                    <hr class="text-white-50 mx-3"/>

                                    <!-- Logout -->
                                    <ul class="nav flex-column">
                                        <li class="nav-item">
                                            <a class="nav-link text-white" href="/edu/logout">
                                                <i class="fa fa-sign-out me-2"></i>
                                                Logout
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </nav>

                            <!-- Main Content -->
                            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 edu-main-content">
                                <!-- Top Bar -->
                                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                                    <h1 class="h2">
                                        <i class="fa fa-tachometer me-2"></i>Student Dashboard
                                    </h1>
                                    <div class="btn-toolbar mb-2 mb-md-0">
                                        <span class="text-muted">
                                            Welcome back, <strong t-esc="student_name"/>!
                                        </span>
                                    </div>
                                </div>

                                <!-- Quick Stats Cards -->
                                <div class="row mb-4">
                                    <div class="col-md-4 mb-3">
                                        <div class="card border-primary h-100">
                                            <div class="card-body text-center">
                                                <i class="fa fa-file-text fa-3x text-primary mb-3"></i>
                                                <h3 class="text-primary" t-esc="pending_petitions"/>
                                                <p class="text-muted mb-0">Pending Petitions</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="card border-success h-100">
                                            <div class="card-body text-center">
                                                <i class="fa fa-book fa-3x text-success mb-3"></i>
                                                <h3 class="text-success" t-esc="registered_courses"/>
                                                <p class="text-muted mb-0">Registered Courses</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="card border-warning h-100">
                                            <div class="card-body text-center">
                                                <i class="fa fa-clock-o fa-3x text-warning mb-3"></i>
                                                <h3 class="text-warning" t-esc="upcoming_exams"/>
                                                <p class="text-muted mb-0">Upcoming Exams</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Quick Actions -->
                                <div class="row mb-4">
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-header bg-light">
                                                <h5 class="mb-0">
                                                    <i class="fa fa-bolt me-2"></i>Quick Actions
                                                </h5>
                                            </div>
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-lg-3 mb-3">
                                                        <a href="/student/petitions" class="btn btn-outline-primary btn-lg w-100">
                                                            <i class="fa fa-plus-circle me-2"></i>
                                                            New Petition
                                                        </a>
                                                    </div>
                                                    <div class="col-md-6 col-lg-3 mb-3">
                                                        <a href="/student/registration" class="btn btn-outline-success btn-lg w-100">
                                                            <i class="fa fa-plus me-2"></i>
                                                            Register Courses
                                                        </a>
                                                    </div>
                                                    <div class="col-md-6 col-lg-3 mb-3">
                                                        <button class="btn btn-outline-info btn-lg w-100" disabled="disabled">
                                                            <i class="fa fa-download me-2"></i>
                                                            Transcripts
                                                        </button>
                                                    </div>
                                                    <div class="col-md-6 col-lg-3 mb-3">
                                                        <button class="btn btn-outline-secondary btn-lg w-100" disabled="disabled">
                                                            <i class="fa fa-envelope me-2"></i>
                                                            Messages
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Announcements Placeholder -->
                                <div class="row">
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-header bg-light">
                                                <h5 class="mb-0">
                                                    <i class="fa fa-bullhorn me-2"></i>Announcements
                                                </h5>
                                            </div>
                                            <div class="card-body">
                                                <t t-if="announcements">
                                                    <t t-foreach="announcements" t-as="announcement">
                                                        <div class="alert alert-info">
                                                            <t t-esc="announcement"/>
                                                        </div>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <div class="text-center text-muted py-4">
                                                        <i class="fa fa-info-circle fa-3x mb-3"></i>
                                                        <p>No announcements at this time.</p>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </main>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ================================================= -->
    <!-- STUDENT PETITIONS PAGE (Placeholder)              -->
    <!-- ================================================= -->
    <template id="student_petitions" name="Student Petitions" customize_show="False">
