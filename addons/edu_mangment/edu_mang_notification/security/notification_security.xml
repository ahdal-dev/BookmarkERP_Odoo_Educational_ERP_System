<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal users (students) may only see their own notifications when
         accessing Odoo directly. Internal/staff users (incl. the gateway
         service account) are unrestricted so the gateway can serve any user. -->
    <record id="rule_edu_notification_portal_own" model="ir.rule">
        <field name="name">Own notifications (portal)</field>
        <field name="model_id" ref="model_edu_notification"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
