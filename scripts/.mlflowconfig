# MLflow Configuration for Odoo Educational ERP System
# This file configures MLflow tracking behavior and artifact storage

[mlflow]
# Tracking server configuration
tracking_uri = file:///tmp/mlflow

# Backend store configuration
backend_store_uri = file:///tmp/mlflow

# Default artifact root
artifact_root = file:///tmp/mlflow/artifacts

# Experiment configuration
default_experiment_name = Odoo_ERP_Services

# Run configuration
run_name_prefix = erp_

# Logging configuration
[logging]
# Log level: DEBUG, INFO, WARNING, ERROR
level = INFO

# Log all parameters and metrics
log_all_params = true
log_all_metrics = true

# Artifact logging
[artifacts]
# Artifact storage backend
backend = local

# Artifact retention (days)
retention_days = 90

# Compression
compress_artifacts = true

# Service-specific configurations
[services.student_performance]
enabled = true
experiment_name = Student_Performance_Service
description = Student performance prediction and risk assessment
model_type = regression_with_risk_assessment
tags = model_type:regression, service:student_performance, domain:education

[services.grade_predictor]
enabled = true
experiment_name = Grade_Predictor_Service
description = Grade prediction and classification
model_type = classification
tags = model_type:classification, service:grade_predictor, domain:education

[services.ocr]
enabled = true
experiment_name = OCR_Service
description = Optical Character Recognition and document extraction
model_type = ocr
tags = model_type:ocr, service:ocr, domain:document_processing

[services.system_integration]
enabled = true
experiment_name = System_Integration
description = Cross-service integration tests and performance
model_type = integration
tags = model_type:integration, service:system, domain:integration

# Metrics thresholds for alerting
[thresholds]
# Student Performance Service
student_performance_min_trajectory_accuracy = 0.75
student_performance_min_risk_accuracy = 0.70

# Grade Predictor Service
grade_predictor_min_accuracy = 0.80
grade_predictor_min_confidence = 0.75

# OCR Service
ocr_min_extraction_accuracy = 0.85
ocr_max_extraction_time_ms = 2000

# Report generation
[reporting]
# Generate HTML report
generate_html = true

# Include metrics comparison
include_comparison = true

# Include historical trends
include_trends = true

# Report title
title = Odoo Educational ERP System - Model Tracking Report

# Report footer
footer = Generated by GitHub Actions MLflow Pipeline

# Archive configuration
[archiving]
# Enable archiving
enabled = true

# Archive location
archive_path = model_results_archive

# Compression format: tar, zip, tar.gz
compression = tar.gz

# Retention policy (days)
retention_days = 365

# GitHub Actions integration
[github_actions]
enabled = true

# Upload artifacts
upload_artifacts = true

# Create deployment annotations
create_annotations = true

# Artifact retention in GitHub
github_retention_days = 90
