<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Demo Teachers -->
    <record id="demo_teacher_1" model="education.teacher">
        <field name="name">Dr. Sarah Johnson</field>
        <field name="email">sarah.johnson@university.edu</field>
        <field name="phone">+1-555-0101</field>
        <field name="department">Computer Science</field>
        <field name="qualification">PhD in Computer Science</field>
        <field name="experience_years">15</field>
    </record>

    <record id="demo_teacher_2" model="education.teacher">
        <field name="name">Prof. Michael Brown</field>
        <field name="email">michael.brown@university.edu</field>
        <field name="phone">+1-555-0102</field>
        <field name="department">Mathematics</field>
        <field name="qualification">PhD in Mathematics</field>
        <field name="experience_years">12</field>
    </record>

    <!-- Demo Courses -->
    <record id="demo_course_1" model="education.course">
        <field name="name">Introduction to Programming</field>
        <field name="description">Basic programming concepts using Python</field>
        <field name="credits">3</field>
        <field name="duration_hours">45</field>
        <field name="semester">Fall 2024</field>
        <field name="teacher_id" ref="demo_teacher_1"/>
    </record>

    <record id="demo_course_2" model="education.course">
        <field name="name">Calculus I</field>
        <field name="description">Differential and integral calculus</field>
        <field name="credits">4</field>
        <field name="duration_hours">60</field>
        <field name="semester">Fall 2024</field>
        <field name="teacher_id" ref="demo_teacher_2"/>
    </record>

    <!-- Demo Students -->
    <record id="demo_student_1" model="education.student">
        <field name="name">Alice Smith</field>
        <field name="email">alice.smith@student.edu</field>
        <field name="phone">+1-555-0201</field>
        <field name="date_of_birth">2000-05-15</field>
        <field name="address">123 Main St, City, State</field>
        <field name="current_semester">Sophomore</field>
        <field name="gpa">3.8</field>
    </record>

    <record id="demo_student_2" model="education.student">
        <field name="name">Bob Wilson</field>
        <field name="email">bob.wilson@student.edu</field>
        <field name="phone">+1-555-0202</field>
        <field name="date_of_birth">2001-03-22</field>
        <field name="address">456 Oak Ave, City, State</field>
        <field name="current_semester">Freshman</field>
        <field name="gpa">3.5</field>
    </record>

    <!-- Demo Enrollments -->
    <record id="demo_enrollment_1" model="education.enrollment">
        <field name="student_id" ref="demo_student_1"/>
        <field name="course_id" ref="demo_course_1"/>
        <field name="grade">A-</field>
        <field name="status">completed</field>
    </record>

    <record id="demo_enrollment_2" model="education.enrollment">
        <field name="student_id" ref="demo_student_2"/>
        <field name="course_id" ref="demo_course_2"/>
        <field name="grade">B+</field>
        <field name="status">completed</field>
    </record>
</odoo>
