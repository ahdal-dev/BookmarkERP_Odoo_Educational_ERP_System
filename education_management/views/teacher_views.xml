<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Teacher Tree View -->
    <record id="view_education_teacher_tree" model="ir.ui.view">
        <field name="name">education.teacher.tree</field>
        <field name="model">education.teacher</field>
        <field name="arch" type="xml">
            <tree>
                <field name="teacher_id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="department"/>
                <field name="qualification"/>
                <field name="experience_years"/>
            </tree>
        </field>
    </record>

    <!-- Teacher Form View -->
    <record id="view_education_teacher_form" model="ir.ui.view">
        <field name="name">education.teacher.form</field>
        <field name="model">education.teacher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="teacher_id"/>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="department"/>
                            <field name="qualification"/>
                            <field name="experience_years"/>
                            <field name="hire_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="course_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Teacher Search View -->
    <record id="view_education_teacher_search" model="ir.ui.view">
        <field name="name">education.teacher.search</field>
        <field name="model">education.teacher</field>
        <field name="arch" type="xml">
            <search>
                <field name="teacher_id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="department"/>
            </search>
        </field>
    </record>

    <!-- Teacher Actions -->
    <record id="action_education_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">education.teacher</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                                    (0, 0, {'view_mode': 'tree', 'view_id': ref('view_education_teacher_tree')}),
                                    (0, 0, {'view_mode': 'form', 'view_id': ref('view_education_teacher_form')})]"/>
    </record>
</odoo>
