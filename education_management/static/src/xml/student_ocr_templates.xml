<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="EducationManagement.IDDocumentOCR" owl="1">
        <div class="o_id_document_ocr">
            <div class="mb-2">
                <label class="o_form_label">Upload ID Document for OCR</label>
                <input type="file" class="form-control" accept="image/*"/>
                <small class="form-text text-muted">
                    Upload a clear photo of the national ID card to auto-fill form fields
                </small>
            </div>
            <div class="ocr-loading" style="display: none;">
                <i class="fa fa-spinner fa-spin"/> Processing document...
            </div>
        </div>
    </t>
</templates>
