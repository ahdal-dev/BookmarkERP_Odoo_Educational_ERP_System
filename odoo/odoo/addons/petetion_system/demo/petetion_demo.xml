    <field name="petition_type_id" ref="petition_type_leave_request"/>
    <field name="description">Requesting leave for 1 semester due to family reasons.</field>
    <field name="state">under_review</field>
    <field name="notes">Will provide all supporting documentation.</field>
</record>

