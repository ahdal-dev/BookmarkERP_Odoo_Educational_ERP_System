<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo Programs -->
    <!-- Demo Petition Types -->
<record id="petition_type_course_change" model="petetion.petetion_type">
    <field name="name">Course Change</field>
    <field name="description">Request to change enrolled course or program.</field>
    <field name="active">True</field>
</record>

<record id="petition_type_leave_request" model="petetion.petetion_type">
    <field name="name">Leave Request</field>
    <field name="description">Request for temporary leave from studies.</field>
    <field name="active">True</field>
</record>

<record id="petition_type_scholarship" model="petetion.petetion_type">
    <field name="name">Scholarship Request</field>
    <field name="description">Request for scholarship or financial assistance.</field>
    <field name="active">True</field>
</record>

<record id="petition_type_complaint" model="petetion.petetion_type">
    <field name="name">Complaint</field>
    <field name="description">Submit a complaint regarding faculty, facilities, or services.</field>
    <field name="active">True</field>
</record>

<!-- Demo Petitions -->
<record id="petition_demo_1" model="petetion.petetion">
    <field name="name">Alice Thompson</field>
    <field name="email">alice.thompson@example.com</field>
    <field name="phone">+1234567801</field>
    <field name="petition_type_id" ref="petition_type_course_change"/>
    <field name="description">Requesting to switch from Computer Science to Data Science track.</field>
    <field name="state">submitted</field>
    <field name="notes">Strong interest in AI and machine learning projects.</field>
</record>

