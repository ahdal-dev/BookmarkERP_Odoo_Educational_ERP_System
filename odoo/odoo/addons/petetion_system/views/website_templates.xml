<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Petition Submission Form -->
    <template id="apply_petetion_form" name="Submit a Petition">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <div class="text-center mb-4">
                                <h1 class="display-4">Submit a Petition</h1>
                                <p class="lead text-muted">
                                    Fill out the form below to submit your petition.
                                </p>
                            </div>

                            <t t-if="errors">
                                <div class="alert alert-danger" role="alert">
                                    <h5 class="alert-heading">Please correct the following errors:</h5>
                                    <ul class="mb-0">
                                        <t t-foreach="errors" t-as="error">
                                            <li><t t-esc="error"/></li>
                                        </t>
                                    </ul>
                                </div>
                            </t>

                            <div class="card shadow-sm">
                                <div class="card-body p-4">
                                    <form action="/petetion/submit" method="post" enctype="multipart/form-data">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                        <h4 class="mb-3 text-primary">
                                            <i class="fa fa-user me-2"></i>Personal Information
                                        </h4>

                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label for="name" class="form-label">
                                                    Full Name <span class="text-danger">*</span>
                                                </label>
                                                <input type="text"
                                                       class="form-control"
                                                       id="name"
                                                       name="name"
                                                       placeholder="Enter your full name"
                                                       required="required"
                                                       t-att-value="form_data.get('name', '') if form_data else ''"/>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="email" class="form-label">
                                                    Email Address <span class="text-danger">*</span>
                                                </label>
                                                <input type="email"
                                                       class="form-control"
                                                       id="email"
                                                       name="email"
                                                       placeholder="your.email@example.com"
                                                       required="required"
                                                       t-att-value="form_data.get('email', '') if form_data else ''"/>
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label for="phone" class="form-label">
                                                    Phone Number <span class="text-danger">*</span>
                                                </label>
                                                <input type="tel"
                                                       class="form-control"
                                                       id="phone"
                                                       name="phone"
                                                       placeholder="+1234567890"
                                                       required="required"
                                                       t-att-value="form_data.get('phone', '') if form_data else ''"/>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label for="national_id" class="form-label">
                                                    National ID Number <span class="text-danger">*</span>
                                                </label>
                                                <input type="text"
                                                       class="form-control"
                                                       id="national_id"
                                                       name="national_id"
                                                       placeholder="Enter your national ID number"
                                                       required="required"
                                                       t-att-value="form_data.get('national_id', '') if form_data else ''"/>
                                                <small class="form-text text-muted">
                                                    This will be used for identity verification
                                                </small>
                                            </div>
                                        </div>

                                        <hr class="my-4"/>

                                        <h4 class="mb-3 text-primary">
                                            <i class="fa fa-file-alt me-2"></i>Petition Details
                                        </h4>

                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label for="petetion_type_id" class="form-label">
                                                    Petition Type <span class="text-danger">*</span>
                                                </label>
                                                <select class="form-control form-select"
                                                        id="petetion_type_id"
                                                        name="petetion_type_id"
                                                        required="required">
                                                    <option value="">-- Choose a Petition Type --</option>
                                                    <t t-foreach="petetion_types" t-as="ptype">
                                                        <option t-att-value="ptype.id"
                                                                t-att-selected="'selected' if form_data and str(ptype.id) == form_data.get('petetion_type_id', '') else None">
                                                            <t t-esc="ptype.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label for="subject" class="form-label">
                                                    Subject / Title
                                                </label>
                                                <input type="text"
                                                       class="form-control"
                                                       id="subject"
                                                       name="subject"
                                                       placeholder="Brief description of your petition"
                                                       t-att-value="form_data.get('subject', '') if form_data else ''"/>
                                            </div>
                                        </div>

                                        <hr class="my-4"/>

                                        <h4 class="mb-3 text-primary">
                                            <i class="fa fa-file-upload me-2"></i>Documents
                                        </h4>

                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label for="attachment_document" class="form-label">
                                                    Upload Supporting Document
                                                </label>
                                                <input type="file"
                                                       class="form-control"
                                                       id="attachment_document"
                                                       name="attachment_document"
                                                       accept=".pdf,.jpg,.jpeg,.png"/>
                                                <small class="form-text text-muted">
                                                    Accepted formats: PDF, JPG, PNG (Max 10MB)
                                                </small>
                                            </div>

                                            <button type="button"
                                                    id="process_ocr"
                                                    class="btn btn-secondary mt-2">
                                                <i class="fa fa-magic me-2"></i>Process Document Automatically
                                            </button>
                                        </div>

                                        <hr class="my-4"/>

                                        <h4 class="mb-3 text-primary">
                                            <i class="fa fa-comment me-2"></i>Additional Information
                                        </h4>

                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label for="notes" class="form-label">
                                                    Additional Notes (Optional)
                                                </label>
                                                <textarea class="form-control"
                                                          id="notes"
                                                          name="notes"
                                                          rows="4"
                                                          placeholder="Any additional information you'd like to share...">
                                                    <t t-if="form_data" t-esc="form_data.get('notes', '')"/>
                                                </textarea>
                                            </div>
                                        </div>

                                        <hr class="my-4"/>

                                        <div class="row">
                                            <div class="col-md-12 text-center">
                                                <button type="submit" class="btn btn-primary btn-lg px-5">
                                                    <i class="fa fa-paper-plane me-2"></i>Submit Petition
                                                </button>
                                            </div>
                                        </div>

                                    </form>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <script type="text/javascript">
document.addEventListener('DOMContentLoaded', function () {
    const processBtn = document.getElementById('process_ocr');
    if (processBtn) {
        processBtn.addEventListener('click', function (e) {
            e.preventDefault();
            const fileInput = document.getElementById('attachment_document');
            if (!fileInput.files || !fileInput.files.length) {
                alert('Please upload a document first');
                return;
            }
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            const originalText = processBtn.innerHTML;
            processBtn.disabled = true;
            processBtn.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i>Processing...';
            fetch('http://localhost:5000/ocr', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                console.log('OCR Response:', data);
                alert('Document processed successfully!');
                if (data.name) document.getElementById('name').value = data.name;
                if (data.national_id) document.getElementById('national_id').value = data.national_id;
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error processing document: ' + error.message);
            })
            .finally(() => {
                processBtn.disabled = false;
                processBtn.innerHTML = originalText;
            });
        });
    }
});
</script>

        </t>
    </template>

    <!-- Petition Success Page -->
    <template id="petetion_success" name="Petition Submitted">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-6 offset-lg-3">
                            <div class="card shadow-sm border-success">
                                <div class="card-body p-5 text-center">
                                    <div class="mb-4">
                                        <i class="fa fa-check-circle text-success" style="font-size: 80px;"></i>
                                    </div>
                                    <h1 class="display-5 text-success mb-3">
                                        Petition Submitted Successfully!
                                    </h1>
                                    <p class="lead mb-4">
                                        Your petition has been received and is under review.
                                    </p>
                                    <div class="alert alert-info mb-4" role="alert">
                                        <h5 class="alert-heading">Your Petition Reference</h5>
                                        <p class="mb-0">
                                            <strong class="fs-4"><t t-esc="reference"/></strong>
                                        </p>
                                        <small class="text-muted">
                                            Please save this reference number for tracking your petition
                                        </small>
                                    </div>
                                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                                        <a href="/" class="btn btn-primary">
                                            <i class="fa fa-home me-2"></i>Back to Home
                                        </a>
                                        <a href="/petetion/check_status" class="btn btn-outline-primary">
                                            <i class="fa fa-search me-2"></i>Check Status
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Petition Status Check Form -->
    <template id="check_petetion_status" name="Check Petition Status">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-6 offset-lg-3">

                            <div class="text-center mb-4">
                                <h1 class="display-5">Check Petition Status</h1>
                                <p class="lead text-muted">
                                    Enter your reference number to view your petition status
                                </p>
                            </div>

                            <div class="card shadow-sm mb-4">
                                <div class="card-body p-4">
                                    <form action="/petetion/check_status" method="get">
                                        <div class="mb-3">
                                            <label for="reference" class="form-label">
                                                Petition Reference Number
                                            </label>
                                            <input type="text"
                                                   class="form-control form-control-lg"
                                                   id="reference"
                                                   name="reference"
                                                   placeholder="PET00001"
                                                   t-att-value="reference"
                                                   required="required"/>
                                        </div>
                                        <div class="d-grid">
                                            <button type="submit" class="btn btn-primary btn-lg">
                                                <i class="fa fa-search me-2"></i>Check Status
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <t t-if="error">
                                <div class="alert alert-warning" role="alert">
                                    <i class="fa fa-exclamation-triangle me-2"></i>
                                    <t t-esc="error"/>
                                </div>
                            </t>

                            <t t-if="petetion">
                                <div class="card shadow-sm">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0">Petition Details</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <strong>Reference:</strong><br/>
                                                <t t-esc="petetion.reference"/>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Status:</strong><br/>
                                                <t t-if="petetion.state == 'draft'">
                                                    <span class="badge bg-secondary">Draft</span>
                                                </t>
                                                <t t-if="petetion.state == 'submitted'">
                                                    <span class="badge bg-primary">Submitted</span>
                                                </t>
                                                <t t-if="petetion.state == 'under_review'">
                                                    <span class="badge bg-warning">Under Review</span>
                                                </t>
                                                <t t-if="petetion.state == 'accepted'">
                                                    <span class="badge bg-success">Accepted</span>
                                                </t>
                                                <t t-if="petetion.state == 'rejected'">
                                                    <span class="badge bg-danger">Rejected</span>
                                                </t>
                                            </div>
                                        </div>
                                        <hr/>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <strong>Name:</strong><br/>
                                                <t t-esc="petetion.name"/>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Email:</strong><br/>
                                                <t t-esc="petetion.email"/>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <strong>Petition Type:</strong><br/>
                                                <t t-esc="petetion.petetion_type_id.name"/>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Submission Date:</strong><br/>
                                                <t t-esc="petetion.application_date" t-options="{'widget': 'date'}"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>

                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Website Menu -->
    <record id="menu_apply_petetion" model="website.menu">
        <field name="name">Submit a Petition</field>
        <field name="url">/petetion/apply</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">55</field>
    </record>

</odoo>