graph LR
    classDef route fill:#bbdefb,stroke:#0d47a1,stroke-width:2px,color:#000000;
    classDef module fill:#c8e6c9,stroke:#1b5e20,stroke-width:2px,color:#000000;
    classDef model fill:#ffe0b2,stroke:#e65100,stroke-width:2px,color:#000000;
    classDef data fill:#e1bee7,stroke:#4a148c,stroke-width:2px,color:#000000;

    subgraph GradePredictor ["Grade Predictor Service (FastAPI · Port 8000)"]
        direction TB

        subgraph Routes ["API Routes"]
            R1["POST /predict"]:::route
            R2["GET /health"]:::route
            R3["GET /courses"]:::route
            R4["GET / (UI)"]:::route
        end

        subgraph FeatureEng ["Feature Engineering Module"]
            FE1["Transcript Parser<br/>build_history_lookup()"]:::module
            FE2["Prerequisite Checker<br/>check_prerequisites()"]:::module
            FE3["Domain Averager<br/>domain-specific GPA"]:::module
            FE4["GPA Trend Analyzer<br/>polyfit slope + decay weighting"]:::module
            FE5["27-Feature Vector Builder"]:::module
        end

        subgraph MLEngine ["ML Inference Engine"]
            ML1["XGBoost Regressor<br/>Point GPA Prediction"]:::model
            ML2["XGBoost Classifier<br/>Letter Grade Probabilities"]:::model
            ML3["Conformal Predictor<br/>Grade Interval + Confidence"]:::model
        end

        PKL[("grade_predictor_v3.pkl<br/>Joblib Bundle")]:::data
        CATALOG[("Course Catalog<br/>CATALOG_IDS + COURSE_INFO")]:::data
        PREREQS[("Prerequisite Map<br/>PREREQUISITE_MAP")]:::data
    end

    R1 --> FE1
    FE1 --> FE2 & FE3 & FE4
    FE2 & FE3 & FE4 --> FE5
    FE5 --> ML1 & ML2
    ML1 & ML2 --> ML3
    PKL -.->|"Loaded at startup"| ML1 & ML2
    CATALOG -.->|"Course metadata"| FE1
    PREREQS -.->|"Prereq chains"| FE2