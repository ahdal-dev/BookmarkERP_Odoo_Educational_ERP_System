# ---------------------------------------------------------------------------
# Academic Agent microservice configuration
# ---------------------------------------------------------------------------

# Odoo connection for the agent's tools (Backend/odoo_client.py).
ODOO_URL=http://localhost:8081
ODOO_DB=edu_demo_new
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Shared secret. The gateway sends this as the X-Chatbot-Secret header on
# /agent/query, and it also authorizes the legacy /admin/config endpoint. Must
# match CHATBOT_SHARED_SECRET in the FastAPI gateway and the "Backend Admin
# Token" in Odoo custom_chatbot_admin settings.
CHATBOT_ADMIN_TOKEN=change-me

# --- LLM provider (OpenRouter, OpenAI-compatible) --------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional OpenRouter base URL / attribution headers:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_APP_NAME=Bookmark Academic ERP

# --- AI Prediction microservices (tool backends) --------------------------
# predict_grade and predict_performance POST to these FastAPI ML services.
# Defaults are for local dev; in Docker they are set to the compose service names.
GRADE_PREDICTOR_URL=http://localhost:8000
STUDENT_PERFORMANCE_URL=http://localhost:5002

# --- RabbitMQ (async write offload for registration/petition) --------------
ENABLE_MQ=true
AMQP_URL=amqp://guest:guest@localhost:5672/

# --- Feature flags ---------------------------------------------------------
# RAG document retrieval is off in the integrated deployment (the agent's tools
# are the primary capability). Set true only to run the legacy RAG knowledge base.
ENABLE_RAG=false

# ---------------------------------------------------------------------------
# Legacy standalone RAG/admin stack (only needed if running Backend/main.py).
# Not required for the integrated Academic Agent microservice.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg2://postgres:admin@localhost:5432/ragchatbot
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# EMBEDDING_MODEL=sentence-transformers/distiluse-base-multilingual-cased-v2
# RAG_TOP_K=40
# RAG_LLM_SNIPPETS=8
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# APP_BASE_URL=http://localhost:8001
