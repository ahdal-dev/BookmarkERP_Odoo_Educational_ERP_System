# Odoo connection for the agentic chatbot tools (Backend/odoo_client.py)
# Defaults already match these values if unset.
ODOO_URL=http://localhost:8081
ODOO_DB=edu_demo_new
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Shared secret required by the /admin/config endpoint. Must match the
# "Backend Admin Token" set in the Odoo custom_chatbot_admin settings.
CHATBOT_ADMIN_TOKEN=change-me
