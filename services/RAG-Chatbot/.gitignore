# Ignore virtual environment
venv/

# Ignore environment file
.env

# Ignore Python cache and bytecode
**/__pycache__/
**/*.pyc

# Ignore local database if sqlite is used (though it uses Postgres)
*.db
*.sqlite3

# Ignore OS files
.DS_Store
Thumbs.db

# Generic sample RAG corpora — not part of the Academic ERP agent. Kept out of
# the repo/runtime path; the integrated microservice runs with ENABLE_RAG=false.
Docs/Insurance Data/
Docs/Medical Data/
Docs/Sports Data/
Docs/ML&DL Data/
